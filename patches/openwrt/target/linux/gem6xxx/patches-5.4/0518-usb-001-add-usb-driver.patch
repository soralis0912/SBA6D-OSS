+#ifndef CONFIG_MTU3_MD_USB_EP0_CTRL
+int isr_count_polling(void *arg)
+{
+	struct mtu3 *mtu = arg;
+	int i = 0;
+	unsigned long total_last = 0;
+	unsigned long total = 0;
+	int maxTXEP = 0, maxRXEP = 0;
+	unsigned long maxTXCount = 0, maxRXCount = 0;
+
+	while (!kthread_should_stop()) {
+		if (qmu_isr_burst) {
+			for (i = 1; i < EPNUM; i++) {
+				total += qmu_isr_tx_count[i];
+				total += qmu_isr_rx_count[i];
+
+				if (qmu_isr_tx_count[i] > max_isr)
+					dev_info(mtu->dev, "=== !!!!!!!!!! QMUdone[tx][EP%d]=%lu ===\n",i, qmu_isr_tx_count[i]);
+				if (qmu_isr_rx_count[i] > max_isr)
+					dev_info(mtu->dev, "=== !!!!!!!!!! QMUdone[rx][EP%d]=%lu ===\n",i, qmu_isr_rx_count[i]);
+
+				if (qmu_isr_tx_count[i] > maxTXCount) {
+					maxTXEP = i;
+					maxTXCount = qmu_isr_tx_count[i];
+				}
+
+				if (qmu_isr_rx_count[i] > maxRXCount) {
+					maxRXEP = i;
+					maxRXCount = qmu_isr_rx_count[i];
+				}
+
+				qmu_isr_tx_count[i] = 0;
+				qmu_isr_rx_count[i] = 0;
+			}
+			if ((total_isr + qmu_total_isr) > max_isr || total_isr > max_isr || qmu_total_isr > max_isr)
+				dev_info(mtu->dev, "=== !!!!!!!!!!  Total=%lu / %lu === QMUdone[tx|rx]=%lu / %lu === max TX-EP%d : %lu, max RX-EP%d : %lu\n",
+						total_isr, qmu_total_isr, total, total - total_last, maxTXEP, maxTXCount, maxRXEP, maxRXCount);
+			else
+				dev_info(mtu->dev, "=== Total=%lu / %lu === QMUdone[tx|rx]=%lu / %lu === max TX-EP%d : %lu, max RX-EP%d : %lu\n",
+					total_isr, qmu_total_isr, total, total - total_last, maxTXEP, maxTXCount, maxRXEP, maxRXCount);
+			total_isr = 0;
+			qmu_total_isr = 0;
+			total_last = total;
+			maxTXEP = maxRXEP = maxTXCount = maxRXCount = 0;
+		}
+
+		if (!qmu_isr_debug) {
+			total = 0;
+		}
+		msleep(profile_interval);
+	}
+	return 0;
+}
+
+irqreturn_t mtu3_qmu_isr(struct mtu3 *mtu)
+{
+	void __iomem *mbase = mtu->mac_base;
+	u32 qmu_status;
+	u32 qmu_done_status;
+	int i=0;
+
+	/* U3D_QISAR1 is read update */
+	qmu_status = mtu3_readl(mbase, U3D_QISAR1);
+	qmu_status &= mtu3_readl(mbase, U3D_QIER1);
+
+	qmu_done_status = mtu3_readl(mbase, U3D_QISAR0);
+	qmu_done_status &= mtu3_readl(mbase, U3D_QIER0);
+	mtu3_writel(mbase, U3D_QISAR0, qmu_done_status); /* W1C */
+
+	if (qmu_isr_debug) {
+		qmu_total_isr++;
+		for (i=1; i<EPNUM; i++) {
+			if (qmu_done_status & 0xFFFF) {
+				if ((qmu_done_status & 0xFFFF) & QMU_TX_DONE_INT(i))
+					qmu_isr_tx_count[i]++;
+			}
+
+			if (qmu_done_status >> EPNUM) {
+				if ((qmu_done_status) & QMU_RX_DONE_INT(i))
+					qmu_isr_rx_count[i]++;
+			}
+		}
+
+	} else {
+		for (i=0; i<EPNUM; i++) {
+			qmu_isr_tx_count[i] = 0;
+			qmu_isr_rx_count[i] = 0;
+		}
+	}
+
+	if (qmu_isr_txrx_log) {
+		for (i=1; i<EPNUM; i++) {
+			dev_info(mtu->dev, "=== QMUdone[tx][EP%d]=%lu ===\n",i, qmu_isr_tx_count[i]);
+			dev_info(mtu->dev, "=== QMUdone[rx][EP%d]=%lu ===\n",i, qmu_isr_rx_count[i]);
+		}
+		qmu_isr_txrx_log = 0;
+	}
+
+	if (qmu_isr_debug_log) {
+		dev_info(mtu->dev, "=== QMUdone[tx=%x, rx=%x] QMUexp[%x] ===\n",
+			(qmu_done_status & 0xFFFF), qmu_done_status >> EPNUM,
+			qmu_status);
+	}
+
+	trace_mtu3_qmu_isr(qmu_done_status, qmu_status);
+
+	if (qmu_done_status)
+		qmu_done_isr(mtu, qmu_done_status);
+
+	if (qmu_status)
+		qmu_exception_isr(mtu, qmu_status);
+
+	return IRQ_HANDLED;
+}
+#else
 irqreturn_t mtu3_qmu_isr(struct mtu3 *mtu)
 {
 	void __iomem *mbase = mtu->mac_base;
@@ -622,6 +807,7 @@ irqreturn_t mtu3_qmu_isr(struct mtu3 *mt
 
 	return IRQ_HANDLED;
 }
+#endif
 
