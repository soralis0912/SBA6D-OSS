+int gs_port_get_status(struct gserial *gser)
+{
+	struct gs_port	*port = gser->ioport;
+	int ret = 0x01;
+	//bit-0: function remote wake capable (always 1)
+
+	//bit-1: function remote wakeup (from func_suspend, 0: active, 1: suspend)
+	if ((port->port_low_power_state & GS_PORT_STATE_LOW_POWER) &&
+		(port->port_wakeup_enabled & GS_PORT_WAKEUP_ENABLED)) {
+		ret |= 0x02;
+	}
+	pr_info("%s ret=0x%x port_low_power_state:%d, port_wakeup_enabled:%d\n",
+		__func__, ret, port->port_low_power_state, port->port_wakeup_enabled);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gs_port_get_status);
+
+int gs_port_update_suspend(struct gserial *gser, u8 suspend_opt)
+{
+	struct gs_port	*port = gser->ioport;
+
+	pr_info("%s func suspend_opt=0x%x\n", __func__, suspend_opt);
+	if (suspend_opt & 0x01)
+		port->port_low_power_state = GS_PORT_STATE_LOW_POWER;
+	else
+		port->port_low_power_state = GS_PORT_STATE_NORMAL;
+
+	if (suspend_opt & 0x02)
+		port->port_wakeup_enabled = GS_PORT_WAKEUP_ENABLED;
+	else
+		port->port_wakeup_enabled = GS_PORT_WAKEUP_DISABLED;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gs_port_update_suspend);
