+static void remote_wakeup(struct gs_port *port)
+{
+	struct timespec64 curr_time, diff;
+	ktime_get_real_ts64(&curr_time);
+	diff = timespec64_sub(curr_time, port->port_wakeup_time);
+
+	pr_info("%s gser_suspend_state: %d \n", __func__,
+		port->port_usb->gser_suspend_state);
+	pr_info("%s port_low_power_state:%d, port_wakeup_enabled:%d\n",
+		__func__, port->port_low_power_state,
+ 		port->port_wakeup_enabled);
+
+	pr_info("%s current is lowpowerState, diffTime sec:%llu ns:%ld\n",
+		__func__, (long long)diff.tv_sec, diff.tv_nsec);
+
+	if ((diff.tv_sec > 2) || ((diff.tv_sec == 2) && (diff.tv_nsec > 500000000))) {
+		port->port_wakeup_time = curr_time;
+		pr_info("%s update time and call usb_gadget_wakeup() for ctrl_id: %d",
+			__func__, port->port_usb->ctrl_id);
+		usb_gadget_wakeup(port->port_usb->func.config->cdev->gadget,
+				port->port_usb->ctrl_id);
+	}
+}
+
+static void process_remote_wakeup(struct gs_port *port)
+{
+	if (port->port_low_power_state == GS_PORT_STATE_LOW_POWER) {
+		//usb 3.0 remote wakeup flow
+		if (port->port_wakeup_enabled)
+			remote_wakeup(port);
+	} else {
+		if (port->port_usb->gser_suspend_state == GSERIAL_STATE_SUSPEND)
+			remote_wakeup(port);
+    }
+}
