+#ifndef CONFIG_MTU3_MD_USB_EP0_CTRL
+static int phy_efuse_settings(struct mtk_phy_instance *instance)
+{
+	struct u2phy_banks *u2_banks;
+	struct u3phy_banks *u3_banks;
+	struct device *dev = &instance->phy->dev;
+	struct nvmem_cell *cell;
+	char *efuse_field;
+	u32 *buf;
+	size_t len;
+	u32 evalue, tmp;
+
+	pr_info("%s ++\n", __func__);
+
+	switch (instance->type) {
+	case PHY_TYPE_USB2:
+		u2_banks = &instance->u2_banks;
+		efuse_field = "u2_efuse_data";
+		break;
+
+	case PHY_TYPE_USB3:
+		u3_banks = &instance->u3_banks;
+		efuse_field = "u3_efuse_data";
+		break;
+	default:
+		pr_err("%s - NO efuse tuning for this PHY type!\n", __func__);
+		return -1;
+	}
+
+	cell = nvmem_cell_get(dev, efuse_field);
+	if (IS_ERR(cell)) {
+		pr_err("%s - Cannot get efuse offset in dts\n", __func__);
+		if (PTR_ERR(cell) == -EPROBE_DEFER) {
+			return PTR_ERR(cell);
+		}
+		return -1;
+	}
+	buf = (u32 *)nvmem_cell_read(cell, &len);
+	nvmem_cell_put(cell);
+	if (IS_ERR(buf)) {
+		pr_err("%s - Cannot read efuse data!\n", __func__);
+		return PTR_ERR(buf);
+	}
+
+	switch (instance->type) {
+	case PHY_TYPE_USB2:
+		pr_info("%s - u2_efuse_data: %x\n", __func__, *buf);
+		evalue = (u32)(*buf) & 0x1f;
+		if (evalue) {
+		    tmp = readl(u2_banks->com + U3P_USBPHYACR1);
+		    tmp &= ~PA1_RG_U2_INTR_CAL;
+		    tmp |= PA1_RG_U2_INTR_CAL_VAL(evalue);
+		    writel(tmp, u2_banks->com + U3P_USBPHYACR1);
+		    pr_info("PA1_RG_U2_INTR_CAL=0x%x\n", tmp);
+		}
+		break;
+
+	case PHY_TYPE_USB3:
+		pr_info("%s - u3_efuse_data: %x\n", __func__, *buf);
+		evalue = (u32)(*buf) & 0xf;
+		if (evalue) {
+		    tmp = readl(u3_banks->phyd + U3P_U3_PHYD_IMPCAL1);
+		    tmp &= ~P3D_RG_SSUSB_RX_IMPSEL;
+		    tmp |= P3D_RG_SSUSB_RX_IMPSEL_VAL(evalue);
+		    writel(tmp, u3_banks->phyd + U3P_U3_PHYD_IMPCAL1);
+		    pr_info("P3D_RG_SSUSB_RX_IMPSEL=0x%x\n", tmp);
+		}
+		evalue = ((u32)(*buf) & (0xf<<4)) >> 4;
+		if (evalue) {
+		    tmp = readl(u3_banks->phyd + U3P_U3_PHYD_IMPCAL0);
+		    tmp &= ~P3D_RG_SSUSB_TX_IMPSEL;
+		    tmp |= P3D_RG_SSUSB_TX_IMPSEL_VAL(evalue);
+		    writel(tmp, u3_banks->phyd + U3P_U3_PHYD_IMPCAL0);
+		    pr_info("P3D_RG_SSUSB_TX_IMPSEL=0x%x\n", tmp);
+		}
+		evalue = ((u32)(*buf) & (0x1f<<8)) >> 8;
+		if (evalue) {
+		    tmp = readl(u3_banks->phya + U3P_U3_PHYA_REG0);
+		    tmp &= ~P3A_RG_SSUSB_IEXT_INTR_CTRL;
+		    tmp |= P3A_RG_SSUSB_IEXT_INTR_CTRL_VAL(evalue);
+		    writel(tmp, u3_banks->phya + U3P_U3_PHYA_REG0);
+		    pr_info("P3A_RG_SSUSB_IEXT_INTR_CTRL=0x%x\n", tmp);
+		}
+		break;
+	}
+	kfree(buf);
+
+	return 0;
+}
