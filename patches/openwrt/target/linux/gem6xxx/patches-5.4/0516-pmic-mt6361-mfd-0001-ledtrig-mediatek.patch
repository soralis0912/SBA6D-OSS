--- a/drivers/leds/trigger/Kconfig
+++ b/drivers/leds/trigger/Kconfig
@@ -9,6 +9,14 @@ menuconfig LEDS_TRIGGERS
 
 if LEDS_TRIGGERS
 
+config LEDS_TRIGGER_MEDIATEK
+	tristate "LED Mediatek Trigger"
+	help
+	  This allows LEDs be 3 different trigger which are PWM Mode, CC Mode
+	  And Breath Mode. Only Specific Mediatek LED Chip can use these
+	  3 triggers.
+	  Say Y to enable it.
+
 config LEDS_TRIGGER_TIMER
 	tristate "LED Timer Trigger"
 	help
--- a/drivers/leds/trigger/Makefile
+++ b/drivers/leds/trigger/Makefile
@@ -15,3 +15,4 @@ obj-$(CONFIG_LEDS_TRIGGER_PANIC)	+= ledt
 obj-$(CONFIG_LEDS_TRIGGER_NETDEV)	+= ledtrig-netdev.o
 obj-$(CONFIG_LEDS_TRIGGER_PATTERN)	+= ledtrig-pattern.o
 obj-$(CONFIG_LEDS_TRIGGER_AUDIO)	+= ledtrig-audio.o
+obj-$(CONFIG_LEDS_TRIGGER_MEDIATEK)	+= ledtrig-mediatek.o
