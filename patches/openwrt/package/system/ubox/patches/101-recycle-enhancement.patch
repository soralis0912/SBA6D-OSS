+static void mkdirs(const char *muldir) {
+	int i,len;
+	char str[512];
+	struct stat s = {0};
+
+	strncpy(str, muldir, 512);
+	len=strlen(str);
+
+	for( i=0; i<len; i++ ) {
+		if( str[i]=='/' ) {
+			str[i] = '\0';
+			if(strlen(str) > 0) {
+				while ( stat(str, &s) < 0) {
+					if( !strncmp(str,"data",sizeof(str))
+							|| !strncmp(str,"/data",sizeof(str))) {
+						// wait for data partition mounted
+						sleep(1);
+					} else {
+						if ( mkdir(str, 0755) != 0) {
+							sleep(1);
+						}
+					}
+				}
+			}
+			str[i]='/';
+		}
+	}
+
+	if( len>0 ) {
+		while ( stat(str, &s) < 0) {
+			if ( mkdir(str, 0755) != 0) {
+				sleep(1);
+			}
+		}
+	}
+	return;
+}
