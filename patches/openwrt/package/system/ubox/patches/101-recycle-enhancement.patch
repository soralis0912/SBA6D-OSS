+static void remove_oldest_folder(const char *dir) {
+	char cur_dir[] = ".";
+	char up_dir[] = "..";
+	char dir_name[512];
+	DIR *dirp;
+	struct dirent *dp;
+	struct stat dir_stat;
+
+	if ( 0 != access(dir, F_OK) ) {
+		fprintf(stderr, "%s access error", __FUNCTION__);
+		return;
+	}
+
+	if ( 0 > stat(dir, &dir_stat) ) {
+		fprintf(stderr, "%s get directory stat error", __FUNCTION__);
+		return;
+	}
+
+	if ( S_ISDIR(dir_stat.st_mode) ) {
+		dirp = opendir(dir);
+		if ( dirp == NULL ) return;
+		while ( (dp=readdir(dirp)) != NULL ) {
+			if ( (0 == strcmp(cur_dir, dp->d_name)) || (0 == strcmp(up_dir, dp->d_name)) ) {
+				continue;
+			}
+
+			sprintf(dir_name, "%s/%s", dir, dp->d_name);
+			syslog( LOG_INFO, "%s remove %s folder", __FUNCTION__, dir_name);
+			remove_oldest_folder(dir_name);
+		}
+		closedir(dirp);
+
+		rmdir(dir);
+	} else if (S_ISREG(dir_stat.st_mode)) {
+		remove(dir);
+	}
+}
+
+static int get_oldest_folder_if_outnumber(const char *dir, char *oldest_folder, int outnumber)
+{
+	char cur_dir[] = ".";
+	char up_dir[] = "..";
+	char dir_name[512];
+	DIR *dirp;
+	struct dirent *dp = NULL;
+	struct stat dir_stat;
+	int folder_count = 0;
+
+	if ( 0 != access(dir, F_OK) ) {
+		syslog( LOG_ERR, "%s access error", __FUNCTION__);
+		return 0;
+	}
+
+	if ( 0 > stat(dir, &dir_stat) ) {
+		syslog( LOG_ERR, "%s get directory stat error", __FUNCTION__);
+		return 0;
+	}
+
+	if ( S_ISDIR(dir_stat.st_mode) ) {
+		dirp = opendir(dir);
+		time_t t_oldest;
+
+		time(&t_oldest);
+		while ( (dp=readdir(dirp)) != NULL ) {
+			if ( (0 == strcmp(cur_dir, dp->d_name)) || (0 == strcmp(up_dir, dp->d_name)) ) {
+				continue;
+			}
+
+			if (dp->d_type == DT_DIR) {
+				folder_count ++;
+				sprintf(dir_name, "%s/%s", dir, dp->d_name);
+				if ( !stat(dir_name, &dir_stat) ) {
+					if(difftime(dir_stat.st_mtime, t_oldest) < 0){
+						t_oldest = dir_stat.st_mtime;
+						memcpy(oldest_folder, dir_name, sizeof(dir_name));
+					}
+				} else {
+					syslog( LOG_INFO, "%s stat file error:%s", __FUNCTION__, strerror(errno));
+				}
+			}
+		}
+		closedir(dirp);
+	}
+
+	syslog( LOG_INFO, "%s oldest_folder_path:%s", __FUNCTION__, oldest_folder);
+	if ( folder_count > outnumber ) {
+		return 1;
+	} else {
+		return 0;
+	}
+}
+
+#ifdef SUPPORT_LOG_RECYCLE
+static unsigned long getStorageRemainSize(const char *storage_path) {
+	int retrycount = 0;
+	struct statfs fileStat;
+
+	syslog(LOG_INFO, "%s check path=%s", __FUNCTION__, storage_path);
+	memset(&fileStat,0,sizeof(fileStat));
+
+	RECHECK:
+	if (statfs(storage_path, &fileStat) == -1) {
+		syslog(LOG_ERR, "%s fail to get storage information: errno=%d", __FUNCTION__, errno);
+		if (errno == EINTR && retrycount > 5) {
+			retrycount ++;
+			usleep(200000);
+			goto RECHECK;
+		} else {
+			return 0;
+		}
+	} else if (0 == fileStat.f_blocks) {
+		// Disk is not available
+		syslog(LOG_ERR, "storage is not available");
+		return 0;
+	}
+	syslog(LOG_INFO, "Logread getStorageRemainSize f_bavail:%lld f_bsize:%lld\n", (long long)fileStat.f_bavail, (long long)fileStat.f_bsize);
+	return (unsigned long) ((fileStat.f_bavail * fileStat.f_bsize) / 1024);
+}
+
+static bool old_folder_recycle(char *folder_name) {
+	char oldest_folder_path[512] = {0};
+	int is_old_folder_found = 0;
+	unsigned long storage_remain_size = 0;
+
+	do {
+		is_old_folder_found = get_oldest_folder_if_outnumber(
+				folder_name,oldest_folder_path,1);
+		syslog(LOG_INFO, "oldest_folder_path:%s\n", oldest_folder_path);
+		if ( is_old_folder_found ) {
+			remove_oldest_folder(oldest_folder_path);
+		} else {
+			return false;
+		}
+
+		storage_remain_size = getStorageRemainSize(folder_name);
+		syslog(LOG_INFO, "storage_remain_szie:%ld \n",storage_remain_size);
+
+		if(storage_remain_size > STORAGE_RESERVED_SPACE/1024) {
+			return true;
+		}
+	} while(1);
+}
+
+static bool doLogRecycle() {
+	char *file_folder = dirname(strdup(log_file));
+	char *recycle_folder = NULL;
+
+	syslog(LOG_INFO, "file folder:%s\n", file_folder);
+	if(strstr(file_folder,"aplog") || strstr(file_folder,"bootlog")) {
+		//file folder contain aplog or bootlog string which mean the file store in /aplog/aplog_time/ or /bootlog/bootlog_time/
+		recycle_folder = dirname(dirname(file_folder));
+	} else {
+		//file folder didn't contain aplog and bootlog
+		recycle_folder = file_folder;
+	}
+	syslog(LOG_INFO, "recycle folder:%s\n", recycle_folder);
+
+	// do aplog folder recycle
+	char aplog_folder_path[512] = {0};
+	sprintf(aplog_folder_path, "%s/%s", recycle_folder, "aplog");
+	if (old_folder_recycle(aplog_folder_path)) {
+		return true;
+	}
+
+	// do bootlog folder recycle
+	char bootlog_folder_path[512] = {0};
+	sprintf(bootlog_folder_path, "%s/%s", recycle_folder, "bootlog");
+	if (old_folder_recycle(bootlog_folder_path)) {
+		return true;
+	}
+
+	// do file recycle
+	if (support_multi_files && (support_max_saving_files_per_time > 2)) {
+		char remove_file_name[512];
+		unsigned long storage_remain_size = 0;
+
+		for( int i=0; i < support_max_saving_files_per_time; i++ ) {
+			memset(remove_file_name, 0, sizeof(char)*512);
+			sprintf(remove_file_name, "%s_%d", log_file, i+1);
+			remove(remove_file_name);
+		}
+		current_file_idx = 0;
+		storage_remain_size = getStorageRemainSize(file_folder);
+		syslog(LOG_INFO, "storage_remain_szie:%ld \n",storage_remain_size);
+
+		if(storage_remain_size > STORAGE_RESERVED_SPACE/1024) {
+			return true;
+		}
+	}
+
+	return false;
+}
+#endif
