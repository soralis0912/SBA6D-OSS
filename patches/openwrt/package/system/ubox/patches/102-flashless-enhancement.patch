+static char *fls_get_timestamp()
+{
+	char curTime[128] = {0};
+	struct tm *tmp;
+	time_t lt;
+
+	lt = time( NULL );
+	if (lt < 0)
+	  syslog(LOG_ERR, "time call failed\n");
+	tmp = localtime( &lt );
+	memset(curTime, 0x0, sizeof(curTime));
+	if (tmp != NULL) {
+	  if (!strftime(curTime, sizeof(curTime), "%Y_%m%d_%H%M%S", tmp))
+	    syslog(LOG_ERR, "strftime returns NULL\n");
+	} else {
+	  curTime[0] = 'E';
+	}
+
+	syslog(LOG_INFO, "TIME: %s\n", curTime );
+	return(strdup(curTime));
+}
