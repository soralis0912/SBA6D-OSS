+/* caller of fls_send() needs to check 'log_fls' before calling */
+static void fls_send(int cmd_type, char *filename) 
+{
+    char buf[256];
+    ssize_t byte;
+
+    if ((cmd_type != FLS_CMD_START) &&
+	(cmd_type != FLS_CMD_STOP)) {
+        syslog(LOG_DEBUG, "wrong command type specified, no command sent!\n");
+	return;
+    }
+
+    sprintf(buf, FLS_COMMAND_FORMAT, FLS_PATTERN_HEAD, cmd_type,
+	    filename ? filename : "NULL", FLS_PATTERN_TAIL);
+
+    syslog(LOG_DEBUG, "about to write to peer: %s, len: %zu\n",
+	   buf, strlen(buf));
+
+    byte = write(sender.fd, buf, strlen(buf));
+    if (byte < 0) {
+        syslog(LOG_ERR, "fls_send write failed\n");
+    } else {
+        syslog(LOG_DEBUG, "wrote: %zu\n", byte);
+    }
+}
+
+static void sigkill_handler()
+{
+    syslog(LOG_INFO, "Logread receive sigkill.\n");
+    if (log_fls)
+        fls_send(FLS_CMD_STOP, NULL);
+}
