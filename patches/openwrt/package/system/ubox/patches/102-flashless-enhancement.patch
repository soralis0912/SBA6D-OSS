+/***********************************************************************
+ *                       SAP LOG COMMAND FORMAT                        *
+ *<FLS PATTERN HEAD> c <LOG         FILE          NAME> <MAGIC TAIL>   *
+ *$MMEEDDIIAATTEEKK@ 1 SAPLOG_FILE_2022_1007_042357.log $MEDIATEK123   *
+ *123456789012345678901234567890123456789012345678901234567890123456   *
+ *0        1         2         3         4         5         6         *
+ ***********************************************************************/
+
+#define FLS_PATTERN_HEAD "$MMEEDDIIAATTEEKK@" // 18
+#define FLS_DEFAULT_SAPLOG_NAME "SAPLOG_FILE" // 32
+#define FLS_PATTERN_TAIL "$MEDIATEK123"       // 12
+#define FLS_COMMAND_LENGTH 66 // 18+1+1+1+32+1+12 -- do not change
+#define FLS_COMMAND_FORMAT "%18.18s %d %32.32s %12.12s\n"
+
+#define FLS_DEFAULT_CURTIME "0000_0000_000000"
+
+
+enum {
+       FLS_CMD_START,
+       FLS_CMD_STOP,
+};
