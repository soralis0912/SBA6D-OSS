CONFIG_PACKAGE_tc-mod-iptables=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_thermal_core=y
CONFIG_PACKAGE_uclibcxx=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_usb_init=y
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_vnstati2=y
CONFIG_PACKAGE_vpnbypass=y
CONFIG_PACKAGE_wapp=y
CONFIG_PACKAGE_wificonf=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_wpa-cli=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_zlib=y
CONFIG_PREINITOPT=y
CONFIG_PROCD_SHOW_BOOT=y
CONFIG_REQUIRED_BIN_DIR_FILES=""
CONFIG_SQLITE3_COLUMN_METADATA=y
CONFIG_SQLITE3_DYNAMIC_EXTENSIONS=y
CONFIG_SQLITE3_FTS3=y
CONFIG_SQLITE3_FTS4=y
CONFIG_SQLITE3_FTS5=y
CONFIG_SQLITE3_JSON1=y
CONFIG_SQLITE3_RTREE=y
CONFIG_STRACE_LIBDW=y
# CONFIG_STRACE_NONE is not set
CONFIG_STRIP_ARGS="--strip-all"
CONFIG_TARGET_NAME="aarch64-openwrt-linux-musl"
CONFIG_TARGET_PREINIT_DISABLE_FAILSAFE=y
CONFIG_TARGET_PREINIT_TIMEOUT=0
CONFIG_TOOLCHAIN_BIN_PATH="./bin"
CONFIG_TOOLCHAIN_INC_PATH="./include ./include/fortify"
CONFIG_TOOLCHAIN_LIBC="musl"
CONFIG_TOOLCHAIN_LIB_PATH="./lib"
CONFIG_TOOLCHAIN_PREFIX="aarch64-openwrt-linux-musl-"
CONFIG_TOOLCHAIN_ROOT="$(TOPDIR)/../mtk/prebuilt/openwrt-toolchain/arm64-a55_neon-gcc-9.3.0_musl"
CONFIG_USE_EXTERNAL_LIBC=y
# CONFIG_USE_SSTRIP is not set
CONFIG_USE_STRIP=y
CONFIG_WAPP_WPACTRL_SUPPORT=y
CONFIG_WARP_CHIPSET="mt6990"
CONFIG_WARP_DBG_SUPPORT=y
CONFIG_WARP_VERSION=2
CONFIG_WARP_WO_EMBEDDED_LOAD=y
CONFIG_WED_HW_RRO_SUPPORT=y
# CONFIG_WIFI7_NORMAL_SETTING is not set
CONFIG_WIFI7_QUICK_SETTING=y
CONFIG_WPA_MSG_MIN_PRIORITY=1
# CONFIG_first_card is not set
CONFIG_first_card_wifi7=y
CONFIG_first_card_wifi7_EEPROM_name="e2p"
CONFIG_first_card_wifi7_EEPROM_offset="0x0"
CONFIG_first_card_wifi7_EEPROM_size="0xf1000"
CONFIG_first_card_wifi7_apcli_ifname="apcli;apclii;apclix"
CONFIG_first_card_wifi7_bf_sku_path="/etc/wireless/mediatek/bellwether-sku-bf.dat"
CONFIG_first_card_wifi7_ext_ifname="ra;rai;rax"
CONFIG_first_card_wifi7_init_compatible="mtwifi"
CONFIG_first_card_wifi7_init_script="/lib/wifi/mtwifi.lua"
CONFIG_first_card_wifi7_main_ifname="ra0;rai0;rax0"
CONFIG_first_card_wifi7_mesh_ifname="mesh;meshi;meshx"
CONFIG_first_card_wifi7_name="MT7990"
CONFIG_first_card_wifi7_nvram_zone="dev00;dev01;dev02"
CONFIG_first_card_wifi7_profile_path="/etc/wireless/mediatek/mt7990.1.dat"
CONFIG_first_card_wifi7_single_sku_path="/etc/wireless/mediatek/bellwether-sku.dat"
CONFIG_first_card_wifi7_wds_ifname="wds;wdsi;wdsx"
# CONFIG_second_card is not set
# CONFIG_third_card is not set
# CONFIG_MTK_WIFI7_RED_SUPPORT is not set
# CONFIG_MTK_WIFI7_VOW_SUPPORT is not set
# CONFIG_WARP_ATC_SUPPORT is not set

# quectel add

CONFIG_DOWNLOAD_FOLDER="$(TOPDIR)/../quectel/prebuilt/openwrt-dl"
CONFIG_EXTERNAL_KERNEL_TREE="$(TOPDIR)/../quectel/ext_kernel-5.4"

CONFIG_PACKAGE_libql_at=y
CONFIG_PACKAGE_libql_qlog=y
CONFIG_PACKAGE_libql_peripheral=y
CONFIG_PACKAGE_mipc_submonitor=y
CONFIG_PACKAGE_ql-datacall=y
CONFIG_PACKAGE_ql-iaapn=y
CONFIG_PACKAGE_ql-netd=y
CONFIG_PACKAGE_ql-ril-client=y
CONFIG_PACKAGE_ql-ril-service=y
CONFIG_PACKAGE_ql-audio=y
CONFIG_PACKAGE_ql-audio-sample=y
CONFIG_PACKAGE_ql-voice=y
CONFIG_PACKAGE_ql-voice-sample=y
CONFIG_PACKAGE_ql-slic=y
CONFIG_PACKAGE_ql-slic-sample=y
CONFIG_PACKAGE_qos-scripts=y
CONFIG_PACKAGE_libql_atcmd=y
CONFIG_PACKAGE_auto_adapt=y
CONFIG_PACKAGE_usxgmii_patch=y
CONFIG_PACKAGE_ql_powerd=y
CONFIG_PACKAGE_ql-ippt=y
#CONFIG_PACKAGE_arp_monitor=y
#CONFIG_PACKAGE_libqlcommon_tools=y
#CONFIG_PACKAGE_mdio_tool=y
CONFIG_PACKAGE_rawdata_test=y
#quectel rawdata drivers Support EMMC
CONFIG_QUECTEL_RAWDATA_EMMC=y
#quectel Atag Support
CONFIG_QUECTEL_ATAG=y

# quectel key mangement
CONFIG_PACKAGE_ql_key_controller=y

# move META_*.EDB to md_database/
CONFIG_QL_CHANGE_META_EDB_DIR=y

# quectel factory all-pin test support
CONFIG_QL_LK_ALLPIN=y

# quectel add  nvram file count check
CONFIG_QL_NVRAM_FILE_COUNT_CHECK=y

# quectel leds controller
CONFIG_PACKAGE_led_controller=y

# quectel enable adb
CONFIG_MTK_ADB_ENABLE=y

# quectel wifi api
CONFIG_PACKAGE_ql_wifi_api=y

#quectel enable MTK lbs_em package
CONFIG_PACKAGE_lbs_em=y

CONFIG_PACKAGE_regs=y

# speed monitor Support joe.huang 2022.12.08
CONFIG_PACKAGE_speed_monitor=y  #record lan devices spped
CONFIG_PACKAGE_libql_speed_monitor=y

#quectel usb otg support
CONFIG_PACKAGE_switch_otg_daemon=y

CONFIG_PACKAGE_mii_mgr=y

#quectel ethernet firmware
CONFIG_PACKAGE_eth_firmware=y

# CONFIG_PACKAGE_valgrind=y

# version info
CONFIG_QL_PLATFORM="RG620TSBK"
CONFIG_MD_EVB="QUECTEL_2102MP5_T830"
CONFIG_MD_NLWG="NLWG_FR1_CUSTOM"

# USB Download Foolproof Switch
CONFIG_QL_CHECK_PLAT="yes"


#quectel add ipsec vpn package.
CONFIG_PACKAGE_strongswan=n
CONFIG_PACKAGE_strongswan-default=n
CONFIG_PACKAGE_iptables-mod-filter=n

#quectel add gre vpn package.
# CONFIG_PACKAGE_luci-proto-gre=y
# CONFIG_BUSYBOX_CONFIG_IPTUNNEL=y
# CONFIG_PACKAGE_luci-proto-ipip=y
# CONFIG_PACKAGE_luci-proto-ipv6=y

#quectel add En8801 support
CONFIG_PACKAGE_kmod-phy-air_en8811h=y

# quectel end
