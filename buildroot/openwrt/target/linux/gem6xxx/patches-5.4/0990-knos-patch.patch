+ *****************************************************************************/
+#ifndef _KNOS_BTN_H_
+#define _KNOS_BTN_H_
+
+typedef struct _knos_btn_driver knos_btn_driver;
+struct _knos_btn_driver
+{
+    const char  *name;
+    unsigned int gpio;
+
+    void (*set_btn_status)(knos_btn_driver *drv, int value);
+    int (*get_btn_status)(knos_btn_driver *drv);
+
+    void        *priv; /* private data */
+};
+
+extern int knos_btn_register_driver(knos_btn_driver *drv);
+extern void knos_btn_unregister_driver(knos_btn_driver *drv);
+extern void knos_btn_status_set( const char *name, int value );
+extern int knos_btn_status_get( const char *name );
+#endif
diff -urpN ext_kernel-5.4.org/drivers/knos-drivers/knos-btn/knos_btn_main.c ext_kernel-5.4/drivers/knos-drivers/knos-btn/knos_btn_main.c
--- ext_kernel-5.4.org/drivers/knos-drivers/knos-btn/knos_btn_main.c	1970-01-01 09:00:00.000000000 +0900
+++ ext_kernel-5.4/drivers/knos-drivers/knos-btn/knos_btn_main.c	2026-08-19 12:01:02.673379264 +0900
@@ -0,0 +1,225 @@
+
+/*****************************************************************************
+ *
+ * 2012-2023 KeyONet
+ *
+ * This program may by distributed and used for any purpose.
+ * I ask only that you :
+ *   1. Leave this author information intact
+ *   2. Document any changes you make
+ *
+ *****************************************************************************
+   MODULE NAME : knos_btn_main.c
+   
+   REVISION HISTORY:
+   Date       Version  Name                Description
+   ---------- -------  ------------------- -----------------------------------
+ .............................................................................
+   DESCRIPTION:
+   .
+ *****************************************************************************/
+
+/** **************************************************************************
+ ** Includes 
+ ** **************************************************************************/
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/init.h>
+
+#include <linux/kdev_t.h>
+#include <linux/netdevice.h>
+
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/uaccess.h>
+
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/errno.h>
+#include <linux/delay.h>
+#include <linux/fs.h>
+
+#include "knos_btn.h"
+
+
+
+/** **************************************************************************
+ ** Variables 
+ ** **************************************************************************/
+#define DEV_NAME                            "knos_btn"
+#define DEV_VERSION                         "1.0"
+
+typedef struct knos_btn_driver_list knos_btn_driver_list;
+struct knos_btn_driver_list
+{
+    knos_btn_driver_list *next;
+    knos_btn_driver *drv;
+};
+
+static knos_btn_driver_list *knos_btn_drivers;
+
+static DEFINE_SPINLOCK(priv_lockBtn);
+static unsigned long priv_lockBtnIrq = 0;
+#define KNOS_BTN_LOCK()   spin_lock_irqsave(&priv_lockBtn, priv_lockBtnIrq)
+#define KNOS_BTN_UNLOCK() spin_unlock_irqrestore(&priv_lockBtn, priv_lockBtnIrq)
+
+
+
+
+
+
+/** **************************************************************************
+ ** Dummy driver 
+ ** **************************************************************************/
+static void knos_btn_dummy_value_set(knos_btn_driver *drv, int value)
+{
+    /* dummy: don't know how to do */
+}
+
+static int knos_btn_dummy_value_get(knos_btn_driver *drv)
+{
+    /* dummy: don't know how to do */
+    return  -1;
+}
+
+static knos_btn_driver knos_btn_dummy_driver =
+{
+    .name = "dummy",
+    .set_btn_status = knos_btn_dummy_value_set,
+    .get_btn_status = knos_btn_dummy_value_get,
+    .priv = NULL,
+};
+
+
+
+
+/** **************************************************************************
+ ** init 
+ ** **************************************************************************/
+static knos_btn_driver *knos_btn_find_driver( const char *name )
+{
+    knos_btn_driver_list *p = knos_btn_drivers;
+    for (; NULL != p; p = p->next)
+    {
+        if ( !strcasecmp(p->drv->name, name) )
+            return p->drv;
+    }
+    return NULL;
+}
+
+int knos_btn_register_driver(knos_btn_driver *drv)
+{
+    knos_btn_driver_list *p = NULL;
+
+    if (NULL == drv)
+        return -1;
+
+    p = kmalloc(sizeof(knos_btn_driver_list), GFP_KERNEL);
+    if (NULL == p)
+        return -1;
+
+    KNOS_BTN_LOCK();
+    p->next = knos_btn_drivers;
+    p->drv = drv;
+
+    knos_btn_drivers = p;
+    KNOS_BTN_UNLOCK();
+
+    return 0;
+}
+ 
+void knos_btn_unregister_driver(knos_btn_driver *drv)
+{
+    knos_btn_driver_list *p = NULL;
+    knos_btn_driver_list *pre = NULL;
+
+    KNOS_BTN_LOCK();
+    for (p = knos_btn_drivers; NULL != p; p = p->next)
+    {
+        if (p->drv == drv)
+        {
+            if (NULL == pre)
+                knos_btn_drivers = p->next;
+            else
+                pre->next = p->next;
+            kfree(p);
+            break;
+        }
+        pre = p;
+    }
+    KNOS_BTN_UNLOCK();
+}
+
+
+void knos_btn_status_set( const char *name, int value )
+{
+    knos_btn_driver *drv = NULL;
+
+    KNOS_BTN_LOCK();
+    drv = knos_btn_find_driver( name );
+
+    if (NULL == drv)
+        drv = &knos_btn_dummy_driver;
+
+    if (drv->set_btn_status )
+        drv->set_btn_status( drv, value );
+
+    KNOS_BTN_UNLOCK();
+}
+
+int knos_btn_status_get( const char *name )
+{
+    int             value = -1;
+    knos_btn_driver *drv = NULL;
+
+    KNOS_BTN_LOCK();
+    drv = knos_btn_find_driver( name );
+
+    if (NULL == drv)
+        drv = &knos_btn_dummy_driver;
+
+    if (drv->get_btn_status )
+        value = drv->get_btn_status( drv );
+
+    KNOS_BTN_UNLOCK();
+
+    return  value;
+}
+
+EXPORT_SYMBOL(knos_btn_register_driver);
+EXPORT_SYMBOL(knos_btn_unregister_driver);
+EXPORT_SYMBOL(knos_btn_status_set);
+EXPORT_SYMBOL(knos_btn_status_get);
+
+static int knos_btn_init(void)
+{
+    printk("%s Rev : %s\n", DEV_NAME, DEV_VERSION );
+
+    /* already initialized */
+    if (knos_btn_drivers)
+        return 0;
+
+    knos_btn_register_driver(&knos_btn_dummy_driver);
+
+#ifdef CONFIG_KNOS_DRIVER_BTN_RST /* Added by YHCHIN: 20230601 */
+    extern  void knos_btn_rst_init(void);
+    knos_btn_rst_init();
+#endif /* of #ifdef CONFIG_KNOS_DRIVER_BTN_RST */
+
+#ifdef CONFIG_KNOS_DRIVER_BTN_WPS /* Added by YHCHIN: 20230601 */
+#endif /* of #ifdef CONFIG_KNOS_DRIVER_BTN_WPS */
+
+#ifdef CONFIG_KNOS_DRIVER_BTN_LEVEL /* Added by YHCHIN: 20230601 */
+#endif /* of #ifdef CONFIG_KNOS_DRIVER_BTN_LEVEL */
+
+    return 0;
+}
+
+static void knos_btn_exit(void)
+{
+    while (knos_btn_drivers)
+        knos_btn_unregister_driver(knos_btn_drivers->drv);
+}
+
+module_init(knos_btn_init);
+module_exit(knos_btn_exit);
diff -urpN ext_kernel-5.4.org/drivers/knos-drivers/knos-btn/knos_btn_rst.c ext_kernel-5.4/drivers/knos-drivers/knos-btn/knos_btn_rst.c
