diff -urpN ext_kernel-5.4.org/drivers/knos-drivers/knos-ctrl/knos_ctrl_main.c ext_kernel-5.4/drivers/knos-drivers/knos-ctrl/knos_ctrl_main.c
--- ext_kernel-5.4.org/drivers/knos-drivers/knos-ctrl/knos_ctrl_main.c	1970-01-01 09:00:00.000000000 +0900
+++ ext_kernel-5.4/drivers/knos-drivers/knos-ctrl/knos_ctrl_main.c	2026-08-19 12:01:02.673503651 +0900
@@ -0,0 +1,389 @@
+
+/*****************************************************************************
+ *
+ * 2012-2023 KeyONet
+ *
+ * This program may by distributed and used for any purpose.
+ * I ask only that you :
+ *   1. Leave this author information intact
+ *   2. Document any changes you make
+ *
+ *****************************************************************************
+   MODULE NAME : knos_ctrl_main.c
+   
+   REVISION HISTORY:
+   Date       Version  Name                Description
+   ---------- -------  ------------------- -----------------------------------
+ .............................................................................
+   DESCRIPTION:
+   .
+ *****************************************************************************/
+/** **************************************************************************
+ ** Includes 
+ ** **************************************************************************/
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/init.h>
+
+#include <linux/fs.h>
+#include <linux/kdev_t.h>
+#include <linux/netdevice.h>
+#include <asm/io.h>
+#include <asm/uaccess.h>
+#include <linux/ioport.h>
+#include <linux/delay.h>
+#include <linux/spinlock.h>
+#include <linux/interrupt.h>
+#include <linux/seq_file.h>
+#include <linux/miscdevice.h>
+
+#include <linux/gpio.h>
+#include <linux/version.h>
+
+#include <knos/_knos_cfg.h>
+
+
+
+
+
+/** **************************************************************************
+ ** Define 
+ ** **************************************************************************/
+#define DEV_NAME                            "knos_ctrl"
+#define DEV_VERSION                         "3.0"
+
+#define DEV_TYPE_BASIC                      1 
+
+/* ioctl */
+#define DEV_KNOS_CTRL_IO                    's'
+#define DEV_KNOS_CTRL_IOCG_ALL              _IO(DEV_KNOS_CTRL_IO,0x01)
+#define DEV_KNOS_CTRL_IOCG_FLAGS            _IO(DEV_KNOS_CTRL_IO,0x02)
+#define DEV_KNOS_CTRL_IOCG_DFS              _IO(DEV_KNOS_CTRL_IO,0x03)
+#define DEV_KNOS_CTRL_IOCG_THERMAL          _IO(DEV_KNOS_CTRL_IO,0x04)
+
+struct knos_ctrl_data 
+{
+    unsigned int    flags;
+    unsigned int    type;
+
+    struct
+    {
+        unsigned int    sts;
+        unsigned int    toCh;
+    } dfs_event;
+    struct
+    {
+        unsigned int    sts;
+        unsigned int    temperature;
+    } thermal_event;
+    struct
+    {
+        unsigned int    sts;
+        unsigned int    flag;
+    } kernel_fault, 
+        device_fault;
+};
+
+
+
+/** **************************************************************************
+ ** Variables 
+ ** **************************************************************************/
+spinlock_t knos_ctrl_lock;
+
+static DEFINE_MUTEX(knos_ctrl_mutex);
+static int knos_ctrl_flag;
+static int knos_ctrl_ioctl_cmd;
+
+struct fasync_struct    *knos_ctrl_async_queue;
+struct knos_ctrl_data   *knos_ctrl_pld;
+
+
+
+
+/** **************************************************************************
+ ** Function 
+ ** **************************************************************************/
+int knos_ctrl_send_signal( unsigned int flag, int argc, char **argv )
+{
+    knos_ctrl_pld->flags |= flag;
+
+    switch( flag )
+    {
+        case    DEV_KNOS_CTRL_EVENT_DFS :
+            if ( argc )
+            {
+                kstrtoint( argv[0], 10, &knos_ctrl_pld->dfs_event.sts );
+            }
+            break;
+        default :
+            break;
+    } // switch
+
+    if( knos_ctrl_flag )
+        kill_fasync (&knos_ctrl_async_queue, SIGIO,POLL_IN);
+
+    return  0;
+}
+EXPORT_SYMBOL(knos_ctrl_send_signal);
+
+
+/** **************************************************************************
+ ** DFS 
+ ** **************************************************************************/
+int knos_ctrl_signal_dfs ( int sts, int toCh )
+{
+    knos_ctrl_pld->flags |= DEV_KNOS_CTRL_EVENT_DFS;
+
+    knos_ctrl_pld->dfs_event.sts  = sts;
+    if ( toCh > 0 )
+        knos_ctrl_pld->dfs_event.toCh = toCh;
+
+    if( knos_ctrl_flag )
+        kill_fasync (&knos_ctrl_async_queue, SIGIO,POLL_IN);
+
+    return  0;
+}
+EXPORT_SYMBOL(knos_ctrl_signal_dfs);
+
+
+
+/** **************************************************************************
+ ** Thermal 
+ ** **************************************************************************/
+int knos_ctrl_signal_thermal ( int sts, int temperature )
+{
+    knos_ctrl_pld->flags |= DEV_KNOS_CTRL_EVENT_THERMAL;
+
+    knos_ctrl_pld->thermal_event.sts  = sts;
+    knos_ctrl_pld->thermal_event.temperature = temperature;
+
+    if( knos_ctrl_flag )
+        kill_fasync (&knos_ctrl_async_queue, SIGIO,POLL_IN);
+
+    return  0;
+}
+EXPORT_SYMBOL(knos_ctrl_signal_thermal);
+
+/** **************************************************************************
+ ** Kernel Fault 
+ ** **************************************************************************/
+int knos_ctrl_signal_kernel_fault ( int sts, int flag )
+{
+    knos_ctrl_pld->flags |= DEV_KNOS_CTRL_EVENT_KERNEL_FAULT;
+
+    knos_ctrl_pld->kernel_fault.sts  = sts;
+    knos_ctrl_pld->kernel_fault.flag = flag;
+
+    if( knos_ctrl_flag )
+        kill_fasync (&knos_ctrl_async_queue, SIGIO,POLL_IN);
+
+    return  0;
+}
+EXPORT_SYMBOL(knos_ctrl_signal_kernel_fault);
+
+/** **************************************************************************
+ ** device Fault 
+ ** **************************************************************************/
+int knos_ctrl_signal_device_fault ( int sts, int flag )
+{
+    knos_ctrl_pld->flags |= DEV_KNOS_CTRL_EVENT_DEVICE_FAULT;
+
+    knos_ctrl_pld->device_fault.sts  = sts;
+    knos_ctrl_pld->device_fault.flag = flag;
+
+    if( knos_ctrl_flag )
+        kill_fasync (&knos_ctrl_async_queue, SIGIO,POLL_IN);
+
+    return  0;
+}
+EXPORT_SYMBOL(knos_ctrl_signal_device_fault);
+
+
+
+
+/** **************************************************************************
+ ** file_operations 
+ ** **************************************************************************/
+static int do_get_ioctl_all( unsigned int *arg )
+{
+    int     rc = 0;
+    struct knos_ctrl_data knos_ctrl_priv, *bp = &knos_ctrl_priv;
+
+    spin_lock(&knos_ctrl_lock);
+    memcpy( bp, knos_ctrl_pld, sizeof(struct knos_ctrl_data));
+    spin_unlock(&knos_ctrl_lock);
+
+    if (copy_to_user((void *)arg, (void *)bp, sizeof(struct knos_ctrl_data)))
+    {
+        printk("%s: copy_to_user fail\n", __FUNCTION__);
+        rc = -EFAULT;
+    }
+
+    return rc;
+}
+
+static int do_get_ioctl_flags( unsigned int *arg )
+{
+    put_user(knos_ctrl_pld->flags,(unsigned int*)arg);
+    knos_ctrl_pld->flags = 0;
+
+    return 0;
+}
+
+static long knos_ctrl_ioctl(struct file *filp, unsigned int cmd, unsigned long arg )
+{
+    int     rc = 0;
+    unsigned    minor = iminor(file_inode(filp));
+
+    mutex_lock(&knos_ctrl_mutex);
+    if ( minor != MISC_KNOS_CTRL_MINOR ) 
+    {
+        rc = -ENOTTY;
+        goto done;
+    }
+
+    switch ( cmd )
+    {
+        case    DEV_KNOS_CTRL_IOCG_ALL :
+            rc = do_get_ioctl_all( (void __user *)arg );
+            break;
+        case    DEV_KNOS_CTRL_IOCG_FLAGS :
+            rc = do_get_ioctl_flags( (void __user *)arg );
+            break;
+        default :
+            printk("%s: invalid ioctl %x\n", __FUNCTION__, cmd);
+            rc = -ENOTTY;
+            break;
+    } /* switch */
+done:
+    mutex_unlock(&knos_ctrl_mutex);
+    return  rc;
+}
+
+static int knos_ctrl_open(struct inode *inode, struct file *filp)
+{
+    knos_ctrl_flag++;
+    return  0;
+}
+
+static int knos_ctrl_release(struct inode *inode, struct file *filp)
+{
+    knos_ctrl_flag--;
+    return 0;
+}
+
+static ssize_t knos_ctrl_write(struct file *file, const char __user *data, size_t len, loff_t *ppos)
+{
+    spin_lock(&knos_ctrl_lock);
+
+    if (copy_from_user(&knos_ctrl_ioctl_cmd, (void *)data,  sizeof(unsigned int ) ) )
+    {
+        printk("[error] write  fail\n");
+        return -EFAULT;
+    }
+
+    spin_unlock(&knos_ctrl_lock);
+    return 0;
+}
+
+
+static ssize_t knos_ctrl_read(struct file *file, char __user *buf, size_t len, loff_t *ppos)
+{
+    int     rc = 0;
+
+    switch ( knos_ctrl_ioctl_cmd )
+    {
+        case    DEV_KNOS_CTRL_IOCG_ALL :
+            rc = do_get_ioctl_all( (void __user *)buf );
+            break;
+        case    DEV_KNOS_CTRL_IOCG_FLAGS :
+            rc = do_get_ioctl_flags( (void __user *)buf );
+            break;
+        case    DEV_KNOS_CTRL_IOCG_DFS :
+            break;
+        default :
+            printk("%s: invalid ioctl %x\n", __FUNCTION__, knos_ctrl_ioctl_cmd);
+            rc = -EINVAL;
+            break;
+    } /* switch */
+
+    knos_ctrl_ioctl_cmd = 0;
+    return rc;
+}
+
+static int knos_ctrl_fasync(int fd, struct file *filp, int mode)
+{
+    int retval = 0;
+
+    retval = fasync_helper( fd, filp, mode, &knos_ctrl_async_queue );
+    return retval;
+}
+
+static int knos_ctrl_device_init( void )
+{
+    knos_ctrl_flag      = 0;
+    knos_ctrl_ioctl_cmd = 0;
+
+    knos_ctrl_pld = kmalloc(sizeof(struct knos_ctrl_data),GFP_KERNEL);
+    memset(knos_ctrl_pld, 0, sizeof(struct knos_ctrl_data));
+
+    knos_ctrl_pld->type = DEV_TYPE_BASIC;
+
+    return  0;
+}
+
+static int knos_ctrl_device_exit( void )
+{
+    kfree(knos_ctrl_pld);
+    return  0;
+}
+
+/** **************************************************************************
+ ** Init 
+ ** **************************************************************************/
+static const struct file_operations knos_ctrl_fops = {
+    .owner          = THIS_MODULE,
+    .unlocked_ioctl = knos_ctrl_ioctl,
+    .open           = knos_ctrl_open,
+    .release        = knos_ctrl_release,
+    .write          = knos_ctrl_write,
+    .read           = knos_ctrl_read,
+    .fasync         = knos_ctrl_fasync,
+};
+
+static struct miscdevice knos_ctrl_misc_dev= {
+    .minor = MISC_KNOS_CTRL_MINOR,
+    .name  = DEV_NAME,
+    .fops  = &knos_ctrl_fops,
+};
+
+static int knos_ctrl_init(void)
+{
+    int ret = 0;
+
+    printk("%s Rev : %s\n", DEV_NAME, DEV_VERSION );
+
+    ret = misc_register(&knos_ctrl_misc_dev);
+    if (ret != 0) {
+        printk(KERN_ERR "efirtc: can't misc_register on minor=%d\n",
+                MISC_KNOS_CTRL_MINOR );
+        return ret;
+    }
+
+    spin_lock_init(&knos_ctrl_lock);
+    knos_ctrl_device_init();
+
+    return 0;
+}
+
+static void knos_ctrl_exit(void)
+{
+    knos_ctrl_device_exit();
+
+    misc_deregister( &knos_ctrl_misc_dev );
+}
+
+module_init(knos_ctrl_init);
+module_exit(knos_ctrl_exit);
+
