+
+/** **************************************************************************
+ ** Variables 
+ ** **************************************************************************/
+unsigned char priv_base_mac[6];
+unsigned char priv_cal_mac[6];
+
+#if defined(CONFIG_KNOS_MAC_POLICY)
+    /*
+     * 1. CONFIG_KNOS_MAC_POLICY_MAX, CONFIG_KNOS_MAC_POLICY_LIST
+     *    -  Kconfig.keyonet 에 정의
+     */
+    #define WIRELESS_MAC_POLICY_OFFSET  CONFIG_KNOS_MAC_POLICY_OFFSET
+    #define DEFAULT_MAX_POLICY_MAX      CONFIG_KNOS_MAC_POLICY_MAX
+    #define DEFAULT_MAX_POLICY_LIST     CONFIG_KNOS_MAC_POLICY_LIST
+#else
+    #define WIRELESS_MAC_POLICY_OFFSET  6
+    #define DEFAULT_MAX_POLICY_MAX      9
+    #define DEFAULT_MAX_POLICY_LIST     "1,1,1,1,0,1,2,3,4"
+#endif
+static int policy_idx = 0;
+static int priv_mac_policy[DEFAULT_MAX_POLICY_MAX];
+
+
+/** **************************************************************************
+ ** Functions 
+ ** **************************************************************************/
+static void init_priv_mac_policy( void )
+{
+    int     i;
+    char    *str_parts[DEFAULT_MAX_POLICY_MAX] = {0, };
+    char    *policy_list = NULL;
+
+    policy_list = kstrdup(DEFAULT_MAX_POLICY_LIST, GFP_KERNEL);
+    knos_split_str(policy_list, ',', str_parts, DEFAULT_MAX_POLICY_MAX);
+
+    for (i=0; i<DEFAULT_MAX_POLICY_MAX; i++)
+        priv_mac_policy[i] = simple_strtol( str_parts[i], NULL, 10 );
+
+    if ( policy_list )
+        kfree( policy_list );
+}
+
+/*: intf_idx */
+unsigned int priv_get_macaddr_with_policy(unsigned char* mac, int intf_idx, int is_wireless)
+{
+    unsigned char tmp[4] = {0, };
+    unsigned int *pt_uint_low_mac;
+    unsigned int uint_low_mac;
+    unsigned char *pt_uchar_low_mac;
+    int add_value = 0;
+
+    if (!mac)
+    {
+        return 0;
+    }
+
+#if 0 /* Deleted by YHCHIN-begin :20230421, not yet!!! */
+    if (is_wireless)
+    {
+        intf_idx += WIRELESS_MAC_POLICY_OFFSET;
+        if ((total_radios+1)<MAX_RADIO)
+            total_radios++;
+    }
+#endif /* Delted by YHCHIN-end :20230421, not yet!!! */
+
+    add_value = priv_mac_policy[intf_idx];
+
+    /*: copy mac with base_mac */
+    memcpy(mac, priv_base_mac, 0x6);
+
+    tmp[0] = mac[2];
+    tmp[1] = mac[3];
+    tmp[2] = mac[4];
+    tmp[3] = mac[5];
+
+    pt_uint_low_mac = (unsigned int*)(&tmp[0]);
+    uint_low_mac = *pt_uint_low_mac;
+
+    uint_low_mac = ntohl(uint_low_mac) + add_value;
+    uint_low_mac = htonl(uint_low_mac);
+    pt_uchar_low_mac = (unsigned char*)(&uint_low_mac);
+
+    mac[2] = pt_uchar_low_mac[0];
+    mac[3] = pt_uchar_low_mac[1];
+    mac[4] = pt_uchar_low_mac[2];
+    mac[5] = pt_uchar_low_mac[3];
+
+    return add_value;
+}
+EXPORT_SYMBOL(priv_get_macaddr_with_policy);
+
+
+
+/** **************************************************************************
+ ** sysFS : function
+ ** **************************************************************************/
+static ssize_t SYSTEM_base_mac_read(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+    int len = 0;
+    len = sprintf( buf, "%s", knos_mac2str(priv_base_mac) );
+    return len;
+}
+
+static ssize_t SYSTEM_base_mac_write(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+    char  str[128];
+
+    sscanf(buf, "%s", str);
+    knos_str2mac( str, priv_base_mac );
+    return count;
+}
+
+
+static ssize_t SYSTEM_policy_mac_read(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+    int len = 0;
+    unsigned int add_value = 0;
+
+    unsigned char ret_mac[6] = {0, };
+    add_value = priv_get_macaddr_with_policy(ret_mac, policy_idx, 0);
+    len = sprintf( buf, "%s", knos_mac2str(ret_mac) );
+
+    return len;
+}
+
+static ssize_t SYSTEM_policy_mac_write(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+    sscanf(buf, "%d", &policy_idx);
+    return count;
+}
+
+
+
+/** **************************************************************************
+ ** sysFS : entry
+ ** **************************************************************************/
+KNOS_DEF_SYSFS_ENT(KNOS_SYSFS_MODE, KNOS_SYSFS_TYPE_MAC, SYSTEM, cal_mac,          priv_cal_mac);
+KNOS_DEF_SYSFS_USER_ENT(KNOS_SYSFS_MODE,                 SYSTEM, base_mac);
+KNOS_DEF_SYSFS_USER_ENT(KNOS_SYSFS_MODE,                 SYSTEM, policy_mac);
+
+static struct attribute *knos_cfg_SYSTEM_attrs[] = 
+{
+    &SYSTEM_cal_mac.attr,
+    &SYSTEM_base_mac.attr,
+    &SYSTEM_policy_mac.attr,
+    NULL
+};
+
+static struct attribute_group knos_cfg_SYSTEM_group = {
+    .attrs = knos_cfg_SYSTEM_attrs,
+};
+
+static __init int sysfs_knos_cfg_SYSTEM(void)
+{
+    int ret = 0;
+    struct kobject *knos_cfg_SYSTEM_kobj = NULL;
+
+    if (!knos_cfg_kobj)
+        return -ENOMEM;
+
+    knos_cfg_SYSTEM_kobj = kobject_create_and_add("system", knos_cfg_kobj);
+    if (!knos_cfg_SYSTEM_kobj)
+        return -ENOMEM;
+
+    ret = sysfs_create_group(knos_cfg_SYSTEM_kobj, &knos_cfg_SYSTEM_group);
+    if (ret) {
+        kobject_put(knos_cfg_SYSTEM_kobj);
+        knos_cfg_SYSTEM_kobj = NULL;
+        return ret;
+    }
+
+    init_priv_mac_policy();
+    return ret;
+}
+fs_initcall(sysfs_knos_cfg_SYSTEM);
