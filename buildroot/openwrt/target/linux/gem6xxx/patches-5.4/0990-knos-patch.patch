+{
+    int ret = 0;
+    struct kobject *knos_cfg_KNOS_CTRL_kobj = NULL;
+
+    knos_cfg_KNOS_CTRL_kobj = kobject_create_and_add("ctrl", knos_cfg_kobj);
+    if (!knos_cfg_KNOS_CTRL_kobj)
+        return -ENOMEM;
+
+    ret = sysfs_create_group(knos_cfg_KNOS_CTRL_kobj, &knos_cfg_KNOS_CTRL_group);
+    if (ret) {
+        kobject_put(knos_cfg_KNOS_CTRL_kobj);
+        knos_cfg_KNOS_CTRL_kobj = NULL;
