+   
+   REVISION HISTORY:
+   Date       Version  Name                Description
+   ---------- -------  ------------------- -----------------------------------
+ .............................................................................
+   DESCRIPTION:
+   .
+ *****************************************************************************/
+
+/** **************************************************************************
+ ** include 
+ ** **************************************************************************/
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/init.h>
+
+#include <linux/kdev_t.h>
+#include <linux/netdevice.h>
+
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/uaccess.h>
+
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/errno.h>
+#include <linux/delay.h>
+#include <linux/fs.h>
+#include <linux/gpio.h>
+
+#include "knos_gpio.h" 
+
+
+
+
+/** **************************************************************************
+ ** Variables 
+ ** **************************************************************************/
+#define DEV_NAME                            "knos_gpio"
+#define DEV_VERSION                         "1.0"
+
+typedef struct _knos_gpio_driver_list knos_gpio_driver_list;
+struct _knos_gpio_driver_list
+{
+    knos_gpio_driver_list *next;
+    knos_gpio_driver *drv;
+};
+
+static knos_gpio_driver_list *knos_gpio_drivers;
+
+static DEFINE_SPINLOCK(knos_lockGpio);
+static unsigned long knos_lockGpioIrq = 0;
+
+#define KNOS_GPIO_LOCK()   spin_lock_irqsave(&knos_lockGpio, knos_lockGpioIrq)
+#define KNOS_GPIO_UNLOCK() spin_unlock_irqrestore(&knos_lockGpio, knos_lockGpioIrq)
+
+
+extern  void knos_gpio_qcom_init(void);
+
+/** **************************************************************************
+ ** dummy driver 
+ ** **************************************************************************/
+static knos_gpio_mode_t knos_gpio_dummy_mode_get(knos_gpio_driver *drv, unsigned int gpio)
+{
+    /* dummy: don't know how to do */
+    return KNOS_GPIO_INPUT;
+}
+
+static void knos_gpio_dummy_mode_set(knos_gpio_driver *drv, unsigned int gpio, knos_gpio_mode_t mode, unsigned int value)
+{
+    /* dummy: don't know how to do */
+}
+
+static unsigned int knos_gpio_dummy_value_get(knos_gpio_driver *drv, unsigned int gpio)
+{
+    /* dummy: don't know how to do */
+    return KNOS_GPIO_UNDEF;
+}
+
+static void knos_gpio_dummy_value_set(knos_gpio_driver *drv, unsigned int gpio, unsigned int value)
+{
+    /* dummy: don't know how to do */
+}
+
+static knos_gpio_driver knos_gpio_dummy_driver =
+{
+    .name = "dummy",
+    .gpioFirst = 0,
+    .gpioLast = UINT_MAX,
+    .get_mode = knos_gpio_dummy_mode_get,
+    .set_mode = knos_gpio_dummy_mode_set,
+    .get_value = knos_gpio_dummy_value_get,
+    .set_value = knos_gpio_dummy_value_set,
+    .priv = NULL,
+};
+
+
+
+
+
+/** **************************************************************************
+ ** Driver 
+ ** **************************************************************************/
+static knos_gpio_driver *knos_gpio_find_driver(unsigned int gpio)
+{
+    knos_gpio_driver_list *p = knos_gpio_drivers;
+    for (; NULL != p; p = p->next)
+    {
+        if (p->drv->gpioFirst <= gpio && gpio <= p->drv->gpioLast)
+            return p->drv;
+    }
+    printk("no driver can handle GPIO[%u]\n", gpio);
+    return NULL;
+}
+
+
+knos_gpio_mode_t knos_gpio_mode_get(unsigned int gpio)
+{
+    knos_gpio_driver *drv = NULL;
+    knos_gpio_mode_t mode = KNOS_GPIO_INPUT;
+    int executed = 0;
+
+    KNOS_GPIO_LOCK();
+    drv = knos_gpio_find_driver(gpio);
+
+    if (NULL == drv)
+        drv = &knos_gpio_dummy_driver;
+
+    if (drv->atomicCall)
+    {
+        mode = drv->get_mode(drv, gpio);
+        executed = 1;
+    }
+    KNOS_GPIO_UNLOCK();
+
+    if (!executed)
+        mode = drv->get_mode(drv, gpio);
+
+    return mode;
+}
+
+void knos_gpio_mode_set(unsigned int gpio, knos_gpio_mode_t mode, unsigned int value)
+{
+    knos_gpio_driver *drv = NULL;
+    int executed = 0;
+
+    KNOS_GPIO_LOCK();
+    drv = knos_gpio_find_driver(gpio);
+
+    if (NULL == drv)
+        drv = &knos_gpio_dummy_driver;
+
+    if (drv->atomicCall)
+    {
+        drv->set_mode(drv, gpio, mode, value);
+        executed = 1;
+    }
+    KNOS_GPIO_UNLOCK();
+
+    if (!executed)
+        drv->set_mode(drv, gpio, mode, value);
+}
+
+
+unsigned int knos_gpio_value_get(unsigned int gpio)
+{
+    knos_gpio_driver *drv = NULL;
+    unsigned int value = 0;
+    int executed = 0;
+
+    KNOS_GPIO_LOCK();
+    drv = knos_gpio_find_driver(gpio);
+
+    if (NULL == drv)
+        drv = &knos_gpio_dummy_driver;
+
+    if (drv->atomicCall)
+    {
+        value = drv->get_value(drv, gpio);
+        executed = 1;
+    }
+    KNOS_GPIO_UNLOCK();
+
+    if (!executed)
+        value = drv->get_value(drv, gpio);
+
+    return value;
+}
+#define MAX_KNOS_GPIO_VAL 128
+int knos_pre_out_val_arr[MAX_KNOS_GPIO_VAL] = {-1, };
+
+void knos_gpio_value_set(unsigned int gpio, unsigned int value)
+{
+    knos_gpio_driver *drv = NULL;
+    int executed = 0;
+
+    if (gpio < MAX_KNOS_GPIO_VAL)
+    {
+        if (knos_pre_out_val_arr[gpio] == value)
+        {
+            /*: NOT changed */
+            return;
+        }
+        else
+        {
+            knos_pre_out_val_arr[gpio] = value;
+        }
+    }
+
+    KNOS_GPIO_LOCK();
+    drv = knos_gpio_find_driver(gpio);
+
+    if (NULL == drv)
+        drv = &knos_gpio_dummy_driver;
+
+    if (drv->atomicCall)
+    {
+        drv->set_value(drv, gpio, value);
+        executed = 1;
+    }
+    KNOS_GPIO_UNLOCK();
+
+    if (!executed)
+        drv->set_value(drv, gpio, value);
+}
+void knos_gpio_set(unsigned int gpio, unsigned int value)
+{
+    knos_gpio_mode_set(gpio, KNOS_GPIO_OUTPUT, value);
+    knos_gpio_value_set(gpio, value);
+}
+
+unsigned int knos_gpio_get(unsigned int gpio)
+{
+    knos_gpio_mode_set(gpio, KNOS_GPIO_INPUT, 0);
+    return knos_gpio_value_get(gpio);
+}
+
+void knos_gpio_activate(unsigned int gpio)
+{
+    knos_gpio_driver *drv = NULL;
+    int executed = 0;
+
+    KNOS_GPIO_LOCK();
+    drv = knos_gpio_find_driver(gpio);
+
+    if (NULL == drv)
+        drv = &knos_gpio_dummy_driver;
+
+    if (drv->activate && drv->atomicCall)
+    {
+        drv->activate(drv, gpio);
+        executed = 1;
+    }
+    KNOS_GPIO_UNLOCK();
+
+    if (drv->activate && !executed)
+        drv->activate(drv, gpio);
+}
+
+void knos_gpio_deactivate(unsigned int gpio)
+{
+    knos_gpio_driver *drv = NULL;
+    int executed = 0;
+
+    KNOS_GPIO_LOCK();
+    drv = knos_gpio_find_driver(gpio);
+
+    if (NULL == drv)
+        drv = &knos_gpio_dummy_driver;
+
+    if (drv->deactivate && drv->atomicCall)
+    {
+        drv->deactivate(drv, gpio);
+        executed = 1;
+    }
+    KNOS_GPIO_UNLOCK();
+
+    if (drv->deactivate && !executed)
+        drv->deactivate(drv, gpio);
+}
+int knos_gpio_register_driver(knos_gpio_driver *drv)
+{
+    knos_gpio_driver_list *p = NULL;
+
+    if (NULL == drv)
+        return -1;
+
+    p = kmalloc(sizeof(knos_gpio_driver_list), GFP_KERNEL);
+    if (NULL == p)
+        return -1;
+
+    KNOS_GPIO_LOCK();
+    p->next = knos_gpio_drivers;
+    p->drv = drv;
+
+    knos_gpio_drivers = p;
+    KNOS_GPIO_UNLOCK();
+
+    return 0;
+}
+
+void knos_gpio_unregister_driver(knos_gpio_driver *drv)
+{
+    knos_gpio_driver_list *p = NULL;
+    knos_gpio_driver_list *pre = NULL;
+
+    KNOS_GPIO_LOCK();
+    for (p = knos_gpio_drivers; NULL != p; p = p->next)
+    {
+        if (p->drv == drv)
+        {
+            if (NULL == pre)
+                knos_gpio_drivers = p->next;
+            else
+                pre->next = p->next;
+            kfree(p);
+            break;
+        }
+        pre = p;
+    }
+    KNOS_GPIO_UNLOCK();
+}
+
+EXPORT_SYMBOL(knos_gpio_register_driver);
+EXPORT_SYMBOL(knos_gpio_unregister_driver);
+EXPORT_SYMBOL(knos_gpio_mode_set);
+EXPORT_SYMBOL(knos_gpio_mode_get);
+EXPORT_SYMBOL(knos_gpio_value_set);
+EXPORT_SYMBOL(knos_gpio_value_get);
+EXPORT_SYMBOL(knos_gpio_set);
+EXPORT_SYMBOL(knos_gpio_get);
+EXPORT_SYMBOL(knos_gpio_activate);
+EXPORT_SYMBOL(knos_gpio_deactivate);
+
+
+
+
+/** **************************************************************************
+ ** init 
+ ** **************************************************************************/
+static int knos_gpio_init( void )
+{
+    int i;
+    printk("%s Rev : %s\n", DEV_NAME, DEV_VERSION );
+
+    for(i=0; i<MAX_KNOS_GPIO_VAL; i++)
+        knos_pre_out_val_arr[i] = -1;
+
+    /* already initialized */
+    if (knos_gpio_drivers)
+        return 0;
+
+    knos_gpio_register_driver(&knos_gpio_dummy_driver);
+
+    knos_gpio_qcom_init();
+
+    return  0;
+}
+
+
+static void knos_gpio_exit( void )
+{
+    while (knos_gpio_drivers)
+        knos_gpio_unregister_driver(knos_gpio_drivers->drv);
+}
+
+module_init( knos_gpio_init );
+module_init( knos_gpio_exit );
