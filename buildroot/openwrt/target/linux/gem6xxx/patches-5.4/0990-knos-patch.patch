+#include <knos/_knos_cfg.h>
+#include <knos/_knos_wlan_ioctl.h>
+
+
+/** **************************************************************************
+ ** Variables 
+ ** **************************************************************************/
+enum
+{
+    KNOS_RADIO_2G = 0,
+    KNOS_RADIO_5G,
+    KNOS_RADIO_6G,
+
+    KNOS_RADIO_MAX
+};
+
+struct wlan_mibbucket 
+{
+    unsigned int ChannelBusyTime; /* Every second update once. primary channel only */
+    unsigned int ChannelBusyTimeCcaNavTx; /* Every second update once. including CCA NAV TX time*/
+    unsigned int OBSSAirtime;
+    unsigned int MyTxAirtime;
+    unsigned int MyRxAirtime;
+    unsigned int EDCCAtime;
+    unsigned int PdCount;
+    unsigned int MdrdyCount;
+
+    unsigned int RxCckMdrdyTime;
+    unsigned int RxOfdmLgMixedMdrdyTime;
+    unsigned int RxOfdmGreenMdrdyTime;
+    unsigned int MyMac2phyTxTime;
+
+    unsigned int MibBss0CtrlFrameCntTime;
+    unsigned int MibCntAmpduTime;
+
+    unsigned int MyAjustTxAirTime;
+    unsigned int MyAjustRxAirTime;
+    unsigned int AjustObssAirTime;
+};
+
+static unsigned int             knos_bcn_info[KNOS_RADIO_MAX];
+static struct wlan_mibbucket    knos_mibbucket[KNOS_RADIO_MAX];
+static int             knos_wlan_radio = -1;
+
+
+
+
+/** **************************************************************************
+ ** Functions 
+ ** **************************************************************************/
+/** **************************************************************************
+ ** sysFS : bcn_info
+ ** **************************************************************************/
+static void init_priv_bcn_info( int radio )
+{
+    int     idx;
+    
+    if ( radio == -1 )
+    {
+        for ( idx=0; idx<KNOS_RADIO_MAX; idx++ )
+            knos_bcn_info[idx] = 0;
+    }
+    else
+        knos_bcn_info[radio] = 0;
+}
+
+
+void knos_set_bcn_info( int radio, unsigned int bcncnt )
+{
+    switch( radio )
+    {
+        case KNOS_RADIO_2G:
+        case KNOS_RADIO_5G:
+        case KNOS_RADIO_6G:
+            knos_bcn_info[radio] = bcncnt;
+            break;
+        default:
+            break;
+    } /* switch */
+}
+EXPORT_SYMBOL(knos_set_bcn_info);
+
+
+static ssize_t WLAN_bcn_info_read(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+    int len = 0;
+    len = sprintf( buf, "bcn_info,%u,%u,%u,", knos_bcn_info[0], knos_bcn_info[1], knos_bcn_info[2] );
+    return len;
+}
+
+static ssize_t WLAN_bcn_info_write(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+    int     index = -1;
+    char    cmds[128];
+
+    // echo flush > bcn_info
+    sscanf(buf, "%s", cmds );
+    if ( !strcasecmp( cmds, "flush" ) )
+        init_priv_bcn_info( index );
+
+    return count;
+}
+
+/** **************************************************************************
+ ** sysFS : mibbucket
+ ** **************************************************************************/
+void knos_set_wlan_mibbucket( int radio, unsigned int OBSSAirtime, unsigned int EDCCAtime, 
+        unsigned int MyTxAirtime, unsigned int MyRxAirtime )
+{
+    struct wlan_mibbucket *p;
+
+    switch( radio )
+    {
+        case KNOS_RADIO_2G:
+        case KNOS_RADIO_5G:
+        case KNOS_RADIO_6G:
+            p = (struct wlan_mibbucket *)&knos_mibbucket[radio];
+            memset( &knos_mibbucket[radio], 0, sizeof(struct wlan_mibbucket) );
+            p->OBSSAirtime = OBSSAirtime;
+            p->EDCCAtime   = EDCCAtime;
+            p->MyTxAirtime = MyTxAirtime;
+            p->MyRxAirtime = MyRxAirtime;
+            break;
+        default:
+            break;
+    } /* switch */
+}
+EXPORT_SYMBOL(knos_set_wlan_mibbucket);
+
+
+static ssize_t WLAN_mibbucket_read(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+    int len = 0;
+    int     idx;
+    struct wlan_mibbucket *p;
+
+    if ( knos_wlan_radio == -1 )
+    {
+        for ( idx=0; idx < KNOS_RADIO_MAX; idx++ )
+        {
+            p = (struct wlan_mibbucket *)&knos_mibbucket[idx];
+            len += sprintf( buf+len, "mibbucket,%d,%u,%u,%u,%u,\n", idx,
+                    p->OBSSAirtime, p->EDCCAtime, p->MyTxAirtime, p->MyRxAirtime );
+        }
+    }
+    else
+    {
+        idx = knos_wlan_radio;
+        p = (struct wlan_mibbucket *)&knos_mibbucket[idx];
+        len += sprintf( buf, "mibbucket,%d,%u,%u,%u,%u,", knos_wlan_radio,
+                p->OBSSAirtime, p->EDCCAtime, p->MyTxAirtime, p->MyRxAirtime );
+
+        knos_wlan_radio = -1;
+    }
+    return len;
+}
+
+static ssize_t WLAN_mibbucket_write(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+    sscanf(buf, "%d", &knos_wlan_radio );
+    return count;
+}
+
+/** **************************************************************************
+ ** sysFS : stacountinfo
+ ** **************************************************************************/
+#if 0
+#define     HASH_INFO_SIZE_MAX       512
+static struct _hash_info *wlan_sta_hash_info = NULL;
+
+static void init_wlan_stacountinfo( int size )
+{
+    int     hash_size;
+
+    wlan_sta_hash_info = (struct _hash_info *)kmalloc(sizeof(struct _hash_info), GFP_ATOMIC);
+
+    if ( size <= 0 )                        hash_size = HASH_INFO_SIZE_MAX;
+    else if ( size > HASH_INFO_SIZE_MAX )   hash_size = HASH_INFO_SIZE_MAX;
+    else                                    hash_size = size;
+    hash_db_init (
+            wlan_sta_hash_info,
+            hash_size,  /*: Hash size */
+            6,          /*: Key_width: MAC */
+            sizeof(struct knos_station), /*: Data_size: type */
+            hash_fn_hash_basic,
+            hash_fn_cmp_basic,
+            hash_node_create,
+            hash_node_del,
+            hash_node_find,
+            priv_wips_hash_fn_print
+            );
+}
+#else
+#define     WLAN_STACOUNTINFO_MAX       512
+struct knos_wlan_stacountinfo
+{
+    int                 count;
+    struct knos_station entry[WLAN_STACOUNTINFO_MAX];
+};
+
+static struct knos_wlan_stacountinfo knos_stacountinfo;
+static void init_wlan_stacountinfo( int size )
+{
+    memset( &knos_stacountinfo, 0, sizeof(struct knos_wlan_stacountinfo) );
+}
+#endif
+
+void knos_set_wlan_stacountinfo( struct knos_station sta ) 
+{
+    struct knos_station  *pEntry;
+
+    if ( knos_stacountinfo.count < WLAN_STACOUNTINFO_MAX )
+    {
+        pEntry = (struct knos_station*)&knos_stacountinfo.entry[knos_stacountinfo.count];
+        memcpy( pEntry, &sta, sizeof(struct knos_station) );
+        knos_stacountinfo.count++;
+    }
+}
+EXPORT_SYMBOL(knos_set_wlan_stacountinfo);
+
+
+static ssize_t WLAN_stacountinfo_read(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+    int len = 0;
+    int idx;
+    struct knos_station  *pEntry;
+
+    if ( knos_stacountinfo.count )
+    {
+        for (idx=0; idx<knos_stacountinfo.count; idx++ )
+        {
+            pEntry = (struct knos_station*)&knos_stacountinfo.entry[idx];
+            len += sprintf( buf+len, "stacountinfo,%s,%d,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu\n", 
+                    knos_mac2str( pEntry->MacAddr),
+                    pEntry->Aid,
+                    pEntry->stats.PacketsSent,
+                    pEntry->stats.PacketsReceived,
+                    (unsigned long)pEntry->stats.ErrorsSent,
+                    (unsigned long)pEntry->stats.RetryCount,
+                    pEntry->stats.txMsduRetryCnt,
+                    pEntry->stats.txMsduDropCnt,
+                    pEntry->stats.BytesSent,
+                    pEntry->stats.BytesReceived);
+        }
+    
+        //memset( &knos_stacountinfo, 0, sizeof(struct knos_wlan_stacountinfo) );
+    }
+    return len;
+}
+
+static ssize_t WLAN_stacountinfo_write(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+    int     index = -1;
+    char    cmds[128];
+
+    // echo flush > stacountinfo
+    sscanf(buf, "%s", cmds );
+    if ( !strcasecmp( cmds, "flush" ) )
+        init_wlan_stacountinfo( -1 );
+    return count;
+}
+
+
+
+
+/** **************************************************************************
+ ** sysFS : entry
+ ** **************************************************************************/
+KNOS_DEF_SYSFS_USER_ENT(KNOS_SYSFS_MODE,                 WLAN, bcn_info);
+KNOS_DEF_SYSFS_USER_ENT(KNOS_SYSFS_MODE,                 WLAN, mibbucket);
+KNOS_DEF_SYSFS_USER_ENT(KNOS_SYSFS_MODE,                 WLAN, stacountinfo);
+
+static struct attribute *knos_cfg_WLAN_attrs[] = 
+{
+    &WLAN_bcn_info.attr,
+    &WLAN_mibbucket.attr,
+    &WLAN_stacountinfo.attr,
+    NULL
+};
+
+static struct attribute_group knos_cfg_WLAN_group = {
+    .attrs = knos_cfg_WLAN_attrs,
+};
+
+static __init int sysfs_knos_cfg_WLAN(void)
+{
+    int ret = 0;
+    struct kobject *knos_cfg_WLAN_kobj = NULL;
+
+    if (!knos_cfg_kobj)
+        return -ENOMEM;
+
+    knos_cfg_WLAN_kobj = kobject_create_and_add("wlan", knos_cfg_kobj);
+    if (!knos_cfg_WLAN_kobj)
+        return -ENOMEM;
+
+    ret = sysfs_create_group(knos_cfg_WLAN_kobj, &knos_cfg_WLAN_group);
+    if (ret) {
+        kobject_put(knos_cfg_WLAN_kobj);
+        knos_cfg_WLAN_kobj = NULL;
+        return ret;
+    }
+
+    init_priv_bcn_info( -1 );
+    init_wlan_stacountinfo( -1 );
+    return ret;
+}
+fs_initcall(sysfs_knos_cfg_WLAN);
