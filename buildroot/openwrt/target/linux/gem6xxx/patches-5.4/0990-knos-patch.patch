+/** **************************************************************************
+ ** Functions 
+ ** **************************************************************************/
+int priv_sysfs_read_for_all_type(int type, void* val, char* ret_buf)
+{
+    int ret = 0;
+    switch(type)
+    {
+        case KNOS_SYSFS_TYPE_INT:
+            {
+                int *pt_ret_val;
+                pt_ret_val = (int*)val;
+                ret = sprintf(ret_buf, "%d\n", *pt_ret_val);
+                break;
+            }
+        case KNOS_SYSFS_TYPE_STR:
+            {
+                ret = sprintf(ret_buf, "%s\n", (char*)val);
+                break;
+            }
+        case KNOS_SYSFS_TYPE_MAC:
+            {
+                unsigned char* tmp_mac = (unsigned char*)val;
+                ret = sprintf(ret_buf, "%02X:%02X:%02X:%02X:%02X:%02X\n",
+                        tmp_mac[0],
+                        tmp_mac[1],
+                        tmp_mac[2],
+                        tmp_mac[3],
+                        tmp_mac[4],
+                        tmp_mac[5]
+                        );
+                break;
+            }
+        case KNOS_SYSFS_TYPE_IP:
+            {
+                unsigned int* tmp_ip = (unsigned int*)val;
+                ret = sprintf(ret_buf, "%d.%d.%d.%d\n",
+                        (unsigned char)((ntohl(*tmp_ip) >> 24) & 0xFF),
+                        (unsigned char)((ntohl(*tmp_ip) >> 16) & 0xFF),
+                        (unsigned char)((ntohl(*tmp_ip) >>  8) & 0xFF),
+                        (unsigned char)( ntohl(*tmp_ip)        & 0xFF)
+                        );
+                break;
+            }
+        case KNOS_SYSFS_TYPE_HEX:
+            {
+                unsigned int *pt_ret_val;
+                pt_ret_val = (unsigned int*)val;
+                ret = sprintf(ret_buf, "0x%x", *pt_ret_val);
+                break;
+            }
+        case KNOS_SYSFS_TYPE_SHORT:
+            {
+                unsigned short *pt_ret_val;
+                pt_ret_val = (unsigned short*)val;
+                ret = sprintf(ret_buf, "%hu\n", *pt_ret_val);
+                break;
+            }
+        case KNOS_SYSFS_TYPE_U8:
+            {
+                unsigned char *pt_ret_val;
+                pt_ret_val = (unsigned char*)val;
+                ret = sprintf(ret_buf, "0x%X\n", *pt_ret_val);
+                break;
+            }
+        default:
+            {
+                ret = sprintf(ret_buf, "\n");
+                break;
+            }
+    }
+    return ret;
+}
+
+
+
+/*: ###: For sysfs Write  */
+int priv_sysfs_write_for_all_type(int type, const char* input_buf, void* pt_var)
+{
+    int ret = 0;
+    switch(type)
+    {
+        case KNOS_SYSFS_TYPE_INT:
+            {
+                int *pt_ret_val = (int*)pt_var;
+                sscanf(input_buf, "%d", pt_ret_val);
+                break;
+            }
+        case KNOS_SYSFS_TYPE_STR:
+            {
+                char *pt_ret_val = (char*)pt_var;
+                sscanf(input_buf, "%s", pt_ret_val);
+                break;
+            }
+        case KNOS_SYSFS_TYPE_MAC:
+            {
+                int i;
+                unsigned int tmp_mac[6] = { 0, };
+                unsigned char* pt_ret_val = (unsigned char*)pt_var;
+                memset(tmp_mac, 0x0, sizeof(tmp_mac));
+                sscanf(input_buf, "%02X:%02X:%02X:%02X:%02X:%02X",
+                        &tmp_mac[0],
+                        &tmp_mac[1],
+                        &tmp_mac[2],
+                        &tmp_mac[3],
+                        &tmp_mac[4],
+                        &tmp_mac[5]
+                      );
+
+                for (i=0; i<6; i++)
+                {
+                    pt_ret_val[i] = tmp_mac[i];
+                }
+
+                break;
+            }
+        case KNOS_SYSFS_TYPE_IP:
+            {
+                unsigned int* pt_ret_val = (unsigned int *)pt_var;
+                char* input_ip_str = (char*)input_buf;
+                *pt_ret_val = knos_str2ip(input_ip_str);
+                break;
+            }
+        case KNOS_SYSFS_TYPE_HEX:
+            {
+                unsigned int *pt_ret_val = (unsigned int*)pt_var;
+                sscanf(input_buf, "0x%x", pt_ret_val);
+                break;
+            }
+        case KNOS_SYSFS_TYPE_SHORT:
+            {
+                int tmp_int = 0;
+                unsigned short *pt_ret_val = (unsigned short*)pt_var;
+                sscanf(input_buf, "%d", &tmp_int);
+
+                *pt_ret_val = (unsigned short)tmp_int;
+                break;
+            }
+        case KNOS_SYSFS_TYPE_U8:
+            {
+                int tmp_int = 0;
+                unsigned char *pt_ret_val = (unsigned char*)pt_var;
+                sscanf(input_buf, "%x", &tmp_int);
+                *pt_ret_val = (unsigned char)tmp_int;
+                break;
+            }
+        default:
+            {
+                ret = -1;
+                break;
+            }
+    }
+    return ret;
+}
diff -urpN ext_kernel-5.4.org/net/knos/_knos_system.c ext_kernel-5.4/net/knos/_knos_system.c
