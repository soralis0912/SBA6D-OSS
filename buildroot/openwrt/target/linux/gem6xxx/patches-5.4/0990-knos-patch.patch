+   Date       Version  Name                Description
+   ---------- -------  ------------------- -----------------------------------
+ .............................................................................
+   DESCRIPTION:
+   .
+ *****************************************************************************/
+/** **************************************************************************
+ ** includes 
+ ** **************************************************************************/
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/notifier.h>
+#include <linux/netdevice.h>
+#include <linux/spinlock.h>
+#include <linux/sysctl.h>
+#include <linux/proc_fs.h>
+#include <linux/gpio.h>
+#include <linux/version.h>
+
+#include "knos_btn.h" 
+
+
+
+
+/** **************************************************************************
+ ** Variables 
+ ** **************************************************************************/
+/* RST GPIO */
+#if defined(CONFIG_KNOS_DRIVER_BTN_RST)
+    #define DEFAULT_GPIO_RST        CONFIG_KNOS_DRIVER_BTN_RST_GPIO
+#else
+    #define DEFAULT_GPIO_RST        29
+#endif
+#define GPIO_RST_ACTIVE             0
+
+#define UNIT_MS(_ms)                (((_ms) * HZ) / 1000)
+#define KNOS_BTN_RST_ITV            UNIT_MS(100)    // 100 msec
+
+#define KNOS_BTN_RST_WAIT           10              // 5 sec
+
+struct timer_list   knos_btn_rst_timer;
+
+static int btn_rst_detect;
+static int btn_rst_result;
+
+
+
+/** **************************************************************************
+ ** timer 
+ ** **************************************************************************/
+static void knos_btn_rst_timer_poll (struct timer_list *unused)
+{
+    mod_timer(&knos_btn_rst_timer, jiffies + KNOS_BTN_RST_ITV);
+}
+
+
+
+
+/** **************************************************************************
+ ** Functions 
+ ** **************************************************************************/
+static void knos_btn_rst_status_set(knos_btn_driver *drv, int value)
+{
+    ;
+}
+
+static int knos_btn_rst_status_get(knos_btn_driver *drv)
+{
+    return   -1;
+}
+
+
+void knos_btn_rst_tmr_init( int flag )
+{
+    /* if restart */
+    if ( flag == 1 )
+        del_timer(&knos_btn_rst_timer);
+
+    btn_rst_detect = 0;
+    btn_rst_result = 0;
+
+    timer_setup(&knos_btn_rst_timer, knos_btn_rst_timer_poll, 0);              /* init the timer structure */
+    knos_btn_rst_timer.expires = jiffies + HZ;
+    add_timer(&knos_btn_rst_timer);
+}
+
+/** **************************************************************************
+ ** init 
+ ** **************************************************************************/
+static knos_btn_driver knos_btn_rst_driver =
+{
+    .name = "rst",
+    .gpio = DEFAULT_GPIO_RST,
+    .set_btn_status = knos_btn_rst_status_set,
+    .get_btn_status = knos_btn_rst_status_get,
+    .priv = NULL,
+};
+
+
+void knos_btn_rst_init(void)
+{
+    knos_btn_register_driver(&knos_btn_rst_driver);
+
+    knos_btn_rst_tmr_init(0);
+}
