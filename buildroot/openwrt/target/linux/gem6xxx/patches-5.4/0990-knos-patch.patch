+#include <linux/init.h>
+#include <linux/notifier.h>
+#include <linux/netdevice.h>
+#include <linux/spinlock.h>
+#include <linux/sysctl.h>
+#include <linux/proc_fs.h>
+#include <net/sock.h>
+#include <net/route.h>
+#include <linux/gpio.h>
+#include <linux/version.h>
+
+#include <knos/_knos_cfg.h>
+#include "knos_gpio.h" 
+
+
+/** **************************************************************************
+ ** Variables 
+ ** **************************************************************************/
+
+
+
+
+/** **************************************************************************
+ ** Functions 
+ ** **************************************************************************/
+/* ctrl_gpio */
+static ssize_t GPIO_CTRL_ctrl_gpio_read(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+    int len = 0;
+
+    printk("Input : <gpio> <val> <dir>\n");
+    printk("GPIO direction : 1(in), 2(out)\n");
+
+    return len;
+}
+
+static ssize_t GPIO_CTRL_ctrl_gpio_write(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+    unsigned int gpio_num;
+    unsigned int val;
+    unsigned int type;
+
+    sscanf(buf, "%d %d %d", &gpio_num, &val, &type);
+    if ( (type!=KNOS_GPIO_OUTPUT) && (type!=KNOS_GPIO_INPUT) )
+    {
+        printk("Input : <gpio> <val> <dir>\n");
+        printk("GPIO direction : 0(in), 1(out)\n");
+        goto ctrl_end;
+    }
+
+    printk("### gpio:%d dir:%d, val:%d\n", gpio_num, type, val );
+    knos_gpio_mode_set( gpio_num, type, val );
+
+ctrl_end:
+    return count;
+}
+
+/* get_gpio */
+static ssize_t GPIO_CTRL_get_gpio_read(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+    int len = 0;
+    printk("Input : <gpio>\n");
+    return len;
+}
+
+static ssize_t GPIO_CTRL_get_gpio_write(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+    unsigned int gpio_num;
+    unsigned int val;
+
+    sscanf(buf, "%d", &gpio_num);
+
+    val = knos_gpio_value_get( gpio_num );
+    printk("### gpio:%d val:%d\n", gpio_num, val );
+
+    return count;
+}
+
+/* set gpio */
+static ssize_t GPIO_CTRL_set_gpio_read(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+    int len = 0;
+    printk("Input : <gpio> <val>\n");
+    return len;
+}
+
+static ssize_t GPIO_CTRL_set_gpio_write(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+    unsigned int gpio_num;
+    unsigned int val;
+
+    sscanf(buf, "%d %d", &gpio_num, &val);
+    printk("### gpio:%d val:%d\n", gpio_num, val );
+
+    knos_gpio_value_set( gpio_num, val );
+
+    return count;
+}
+
+KNOS_DEF_SYSFS_USER_ENT(KNOS_SYSFS_MODE, GPIO_CTRL, ctrl_gpio);
+KNOS_DEF_SYSFS_USER_ENT(KNOS_SYSFS_MODE, GPIO_CTRL, get_gpio);
+KNOS_DEF_SYSFS_USER_ENT(KNOS_SYSFS_MODE, GPIO_CTRL, set_gpio);
+
+static struct attribute *knos_cfg_GPIO_CTRL_attrs[] =
+{
+    &GPIO_CTRL_ctrl_gpio.attr,
+    &GPIO_CTRL_get_gpio.attr,
+    &GPIO_CTRL_set_gpio.attr,
+    NULL
+};
+
+static struct attribute_group knos_cfg_GPIO_CTRL_group =
+{
+    .attrs = knos_cfg_GPIO_CTRL_attrs,
+};
+
+
+static __init int sysfs_knos_cfg_GPIO_CTRL (void)
+{
+    int ret = 0;
+    struct kobject *knos_cfg_GPIO_CTRL_kobj = NULL;
+
+    knos_cfg_GPIO_CTRL_kobj = kobject_create_and_add("gpio", knos_cfg_kobj);
+    if (!knos_cfg_GPIO_CTRL_kobj)
+        return -ENOMEM;
+
+    ret = sysfs_create_group(knos_cfg_GPIO_CTRL_kobj, &knos_cfg_GPIO_CTRL_group);
+    if (ret) {
+        kobject_put(knos_cfg_GPIO_CTRL_kobj);
+        knos_cfg_GPIO_CTRL_kobj = NULL;
+        return ret;
+    }
+
+    return 0;
+}
+fs_initcall(sysfs_knos_cfg_GPIO_CTRL);
diff -urpN ext_kernel-5.4.org/drivers/knos-drivers/knos-gpio/knos_gpio_target.c ext_kernel-5.4/drivers/knos-drivers/knos-gpio/knos_gpio_target.c
