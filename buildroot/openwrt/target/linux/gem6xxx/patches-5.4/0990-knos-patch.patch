+/** **************************************************************************
+ ** Functions 
+ ** **************************************************************************/
+size_t hash_fn_hash_basic(const void *key, size_t width, size_t hash_size)
+{
+    size_t hash=0;
+    size_t i=0;
+    char* tmp_key = (char*)key;
+
+    for(i=0; i < width; i++)
+    {
+        hash += (size_t)(tmp_key[i]);
+        hash += (hash << 10);
+        hash ^= (hash >> 6);
+    }
+    hash += (hash << 3);
+    hash ^= (hash >> 11);
+    hash += (hash << 15);
+
+    return hash % hash_size;
+}
+
+
+/*: 0: same */
+/*: 1: diff */
+int hash_fn_cmp_basic(const void *a, struct _hash_node* node, size_t width, int flags)
+{
+    if (node->valid)
+    {
+        return memcmp(a, node->key, width);
+    }
+    /*: Diff */
+    return 1;
+}
+
+
+
+struct _hash_node *hash_node_find(struct _hash_info *hash_info, void *key, void *data)
+{
+    struct _hash_node *find_node = NULL;
+
+    find_node = hash_info->tbl[hash_info->fn_hash(key, hash_info->key_width, hash_info->hash_size)].next;
+
+    while ((find_node != NULL) &&
+            (hash_info->fn_cmp(key, find_node, hash_info->key_width, hash_info->flags) != 0))
+    {
+        find_node = find_node->next;
+    }
+
+    return find_node;
+}
+
+/*: if idx == -1, find idx with hash_fn */
+struct _hash_node *hash_node_create(struct _hash_info *hash_info, void *key, void *data, int idx)
+{
+    struct _hash_node *new_node;
+
+    if ((new_node = (struct _hash_node*)kmalloc(sizeof(struct _hash_node), GFP_ATOMIC)) == NULL)
+    {
+        return NULL;
+    }
+    memset(new_node, 0x0, sizeof(struct _hash_node));
+
+    if ((new_node->key = (void *)kmalloc(hash_info->key_width, GFP_ATOMIC)) == NULL)
+    {
+        kfree(new_node);
+        return NULL;
+    }
+
+    memcpy(new_node->key, key, hash_info->key_width);
+
+    new_node->data = data;
+
+    /*: HASH_TYPE_NORMAL */
+    new_node->valid = 1;
+
+    if (hash_info->fn_hash)
+    {
+        if (idx == -1 && (hash_info->flags & HASH_TYPE_NORMAL))
+        {
+            idx = hash_info->fn_hash(key, hash_info->key_width, hash_info->hash_size);
+        } else
+        {
+            /*: make node at static index of hash table: HASH_TYPE_STATIC_ARRAY */
+        }
+    } else
+    {
+        return NULL;
+    }
+
+    new_node->next = hash_info->tbl[idx].next;
+
+    hash_info->tbl[idx].next = new_node;
+
+    hash_info->node_cnt++;
+    return new_node;
+}
+
+struct _hash_node *hash_node_del(struct _hash_info *hash_info, void *key)
+{
+    struct _hash_node *pre_node;
+    struct _hash_node *tmp_node;
+
+    if (hash_info->node_cnt > 0)
+    {
+        pre_node = &hash_info->tbl[hash_info->fn_hash(key, hash_info->key_width, hash_info->hash_size)];
+
+        tmp_node = pre_node->next;
+
+        while ((tmp_node != NULL) && (hash_info->fn_cmp(key, tmp_node, hash_info->key_width, hash_info->flags)))
+        {
+            pre_node = tmp_node;
+            tmp_node = tmp_node->next;
+        }
+
+        if (tmp_node == NULL) return NULL;
+
+        /*: Normal hash */
+        pre_node->next = tmp_node->next;
+
+        if (tmp_node->key)
+        {
+            kfree(tmp_node->key);
+            tmp_node->key = NULL;
+        }
+
+        if (tmp_node->data)
+        {
+            kfree(tmp_node->data);
+            tmp_node->data = NULL;
+        }
+        kfree(tmp_node);
+        tmp_node = NULL;
+        hash_info->node_cnt--;
+        return pre_node;
+    }
+    return NULL;
+}
+
+int hash_fn_print_basic(struct _hash_info *hash_info, const void* _node, char* buf, int* pt_len)
+{
+    int i;
+    unsigned char* tmp_key;
+    unsigned char* tmp_data;
+    struct _hash_node *node;
+
+    node = (struct _hash_node *)_node;
+    if (node)
+    {
+        tmp_key = (unsigned char*)(node->key);
+        tmp_data = (unsigned char*)(node->data);
+
+        for (i=0; i<hash_info->key_width; i++)
+        {
+            *pt_len = *pt_len + sprintf(buf + *pt_len, "%02x:", tmp_key[i]);
+        }
+        buf[*pt_len-1] = ' ';
+
+        for (i=0; i<hash_info->data_size; i++)
+        {
+            *pt_len = *pt_len + sprintf(buf + *pt_len, "%02x:", tmp_data[i]);
+        }
+        buf[*pt_len-1] = ' ';
+
+        *pt_len = *pt_len + sprintf(buf + *pt_len, "\n");
+    }
+    return 0;
+}
+
+static struct _hash_info *hash_node_del_all(struct _hash_info *hash_info)
+{
+    struct _hash_node *tmp_node;
+    struct _hash_node *del_node;
+    int i;
+    for (i = 0; i < hash_info->hash_size; i++)
+    {
+        tmp_node = hash_info->tbl[i].next;
+        while (tmp_node != NULL)
+        {
+            del_node = tmp_node;
+            tmp_node = tmp_node->next;
+
+            if (del_node->key)
+            {
+                kfree(del_node->key);
+                del_node->key = NULL;
+            }
+
+            if (del_node->data)
+            {
+                kfree(del_node->data);
+                del_node->data = NULL;
+            }
+            kfree(del_node);
+            del_node = NULL;
+        }
+        hash_info->tbl[i].next = NULL;
+    }
+    hash_info->node_cnt = 0;
+    return hash_info;
+}
+
+static int hash_node_list_all(struct _hash_info *hash_info, char* buf, int* pt_len)
+{
+    int i;
+    int cnt = 0;
+    struct _hash_node *tmp_node;
+    for (i = 0; i < hash_info->hash_size; i++)
+    {
+        tmp_node = hash_info->tbl[i].next;
+        if (tmp_node != NULL)
+        {
+            //    printk("\nBucket idx:%d : ", i);
+        }
+
+        while (tmp_node != NULL)
+        {
+            if (tmp_node->valid && hash_info->fn_print)
+            {
+                hash_info->fn_print(hash_info, tmp_node, buf, pt_len);
+                cnt++;
+            }
+            tmp_node = tmp_node->next;
+        }
+    }
+    return cnt;
+}
+
+
+/** **************************************************************************
+ ** init 
+ ** **************************************************************************/
+struct _hash_info* hash_db_init (
+        struct _hash_info* hash_info,
+        size_t input_hash_size,
+        size_t input_key_width,
+        size_t input_data_size,
+        FN_HASH    input_fn_hash,
+        FN_CMP     input_fn_cmp,
+        FN_ADD     input_fn_add,
+        FN_DEL     input_fn_del,
+        FN_FIND    input_fn_find,
+        FN_PRINT   input_fn_print
+        )
+{
+    int i;
+
+    if (hash_info == NULL ||
+            input_hash_size == 0 ||
+            input_key_width == 0 ||
+            (HASH_KEY_LENGTH_MAX <= input_key_width)
+       )
+    {
+        printk("Error in hasn_info:%p, input_hash_size:%d input_key_width:%d %s(%d)\n",
+                hash_info,
+                input_hash_size,
+                input_key_width,
+                __FUNCTION__, __LINE__);
+        return NULL;
+    }
+    memset(hash_info, 0x0, sizeof(struct _hash_info));
+
+    hash_info->hash_size  = input_hash_size;
+    hash_info->key_width  = input_key_width;
+    hash_info->data_size  = input_data_size;
+    hash_info->flags      = HASH_TYPE_NORMAL;
+    hash_info->node_cnt   = 0;
+
+    hash_info->fn_hash    = input_fn_hash;
+    hash_info->fn_cmp     = input_fn_cmp;
+    hash_info->fn_print   = input_fn_print;
+
+    hash_info->fn_add     = input_fn_add;
+    hash_info->fn_del     = input_fn_del;
+    hash_info->fn_find    = input_fn_find;
+    hash_info->fn_print   = input_fn_print;
+
+    hash_info->fn_del_all = hash_node_del_all;
+    hash_info->fn_list_all= hash_node_list_all;
+
+    if ((hash_info->tbl = (struct _hash_node*)kmalloc(sizeof(struct _hash_node)*hash_info->hash_size, GFP_ATOMIC)) == NULL)
+    {
+        return NULL;
+    }
+
+    for (i = 0; i < hash_info->hash_size; i++)
+    {
+        memset(&hash_info->tbl[i], 0x0, sizeof(struct _hash_node));
+        hash_info->tbl[i].next = NULL;
+    }
+
+    return hash_info;
+}
