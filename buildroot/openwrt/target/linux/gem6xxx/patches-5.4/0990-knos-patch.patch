+   
+   REVISION HISTORY:
+   Date       Version  Name                Description
+   ---------- -------  ------------------- -----------------------------------
+ .............................................................................
+   DESCRIPTION:
+   .
+ *****************************************************************************/
+/** **************************************************************************
+ ** include
+ ** **************************************************************************/
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/notifier.h>
+#include <linux/netdevice.h>
+#include <linux/spinlock.h>
+#include <linux/sysctl.h>
+#include <linux/proc_fs.h>
+#include <linux/gpio.h>
+#include <linux/version.h>
+
+#include "knos_gpio.h"
+#include "target/knos_gpio_info.h"
+
+
+
+/** **************************************************************************
+ ** QCA GPIO Read / Write
+ ** **************************************************************************/
+static knos_gpio_mode_t knos_gpio_qcom_mode_get(knos_gpio_driver *drv, unsigned int gpio)
+{
+    return KNOS_GPIO_UNDEF;
+}
+
+static void knos_gpio_qcom_mode_set(knos_gpio_driver *drv, unsigned int gpio, knos_gpio_mode_t mode, unsigned int value)
+{
+    if (gpio < drv->gpioFirst || drv->gpioLast < gpio)
+        return;
+
+    if ( mode == KNOS_GPIO_OUTPUT )
+        gpio_direction_output( gpio, value );
+    else
+        gpio_direction_input( gpio );
+
+    return;
+}
+
+static unsigned int knos_gpio_qcom_value_get(knos_gpio_driver *drv, unsigned int gpio)
+{
+    int     ret = -1;
+
+    if (gpio < drv->gpioFirst || drv->gpioLast < gpio)
+        return ret;
+
+    ret = gpio_get_value( gpio );
+    return ret;
+}
+
+static void knos_gpio_qcom_value_set(knos_gpio_driver *drv, unsigned int gpio, unsigned int value)
+{
+    if (gpio < drv->gpioFirst || drv->gpioLast < gpio)
+        return;
+
+    gpio_set_value( gpio, value );
+    return;
+}
+
+/** **************************************************************************
+ ** Functions
+ ** **************************************************************************/
+int knos_ctrl_gpio(unsigned int mode, unsigned int gpio, int value)
+{
+    int     ret = 0;
+
+    if ( mode == KNOS_GPIO_OUTPUT )
+        gpio_set_value( gpio, value );
+    else if ( mode == KNOS_GPIO_INPUT )
+        ret = gpio_get_value( gpio );
+    else
+        ;
+    return  ret;
+}
+EXPORT_SYMBOL(knos_ctrl_gpio);
+
+int knos_ctrl_direction_gpio(unsigned int mode, unsigned int gpio, int value)
+{
+    int     ret=0;
+
+    if ( mode == KNOS_GPIO_OUTPUT )
+        ret = gpio_direction_output( gpio, value );
+    else if ( mode == KNOS_GPIO_INPUT )
+        ret = gpio_direction_input( gpio );
+    else
+        ;
+    return  ret;
+}
+EXPORT_SYMBOL(knos_ctrl_direction_gpio);
+
+static int knos_gpio_qcom_board_init( void )
+{
+    int     idx;
+/*
+    knos_set_gpio_out = gpio_set_value;
+    knos_get_gpio_in  = gpio_get_value;
+    knos_gpio_direction_input  = gpio_direction_input;
+    knos_gpio_direction_output = gpio_direction_output;
+*/
+    for (idx=0; g_gpio_info[idx].num >= 0; idx++ )
+    {
+        if ( (g_gpio_info[idx].type == KNOS_GPIO_INPUT) ||
+                (g_gpio_info[idx].type == KNOS_GPIO_OUTPUT) )
+        {
+            knos_ctrl_direction_gpio( g_gpio_info[idx].type,
+                    g_gpio_info[idx].num,
+                    g_gpio_info[idx].initial_value );
+        } /* if */
+
+        printk("###GPIO-%2d %6s inital:%d :%s\n",
+                g_gpio_info[idx].num,
+                g_gpio_info[idx].type == KNOS_GPIO_OUTPUT ? "OUTPUT" : "INPUT",
+                g_gpio_info[idx].initial_value,
+                g_gpio_info[idx].description
+              );
+    } /* for */
+
+    return 0;
+}
+
+
+/** **************************************************************************
+ ** init
+ ** **************************************************************************/
+static knos_gpio_driver knos_gpio_qcom_driver =
+{
+    .name = "target",
+    .gpioFirst = 0,
+    .gpioLast = 79,
+    .get_mode = knos_gpio_qcom_mode_get,
+    .set_mode = knos_gpio_qcom_mode_set,
+    .get_value = knos_gpio_qcom_value_get,
+    .set_value = knos_gpio_qcom_value_set,
+    .priv = NULL,
+};
+
+
+void knos_gpio_qcom_init(void)
+{
+    knos_gpio_register_driver(&knos_gpio_qcom_driver);
+
+    knos_gpio_qcom_board_init();
+}
