+/** **************************************************************************
+ ** Functions 
+ ** **************************************************************************/
+int knos_hex2num(char c)
+{
+    if (c >= '0' && c <= '9')
+        return c - '0';
+    if (c >= 'a' && c <= 'f')
+        return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F')
+        return c - 'A' + 10;
+    return -1;
+}
+EXPORT_SYMBOL(knos_hex2num);
+
+unsigned int knos_str2ip(char *str)
+{
+    unsigned int dot[4] = {0, };
+    sscanf(str, "%d.%d.%d.%d",
+            &dot[0], &dot[1], &dot[2], &dot[3]);
+
+    return htonl(
+            ((dot[0] << 24) & 0xff000000) |
+            ((dot[1] << 16) & 0x00ff0000) |
+            ((dot[2] <<  8) & 0x0000ff00) |
+            ((dot[3]      ) & 0x000000ff));
+}
+EXPORT_SYMBOL(knos_str2ip);
+
+int knos_str2mac( const char *str, unsigned char *addr )
+{
+    int i;
+
+    for (i = 0; i < 6; i++) {
+        int a, b;
+        a = knos_hex2num(*str++);
+        if (a < 0)
+            return -1;
+        b = knos_hex2num(*str++);
+        if (b < 0)
+            return -1;
+        *addr++ = (a << 4) | b;
+        if (i < 5 && *str++ != ':')
+            return -1;
+    }
+    return 0;
+}
+EXPORT_SYMBOL(knos_str2mac);
+
+char *knos_mac2str( unsigned char *mac )
+{
+    /*: Input MAC */
+    static char mac_str[32];
+    memset(mac_str, 0x0, sizeof(mac_str));
+    sprintf(mac_str, "%02X:%02X:%02X:%02X:%02X:%02X",
+            mac[0],
+            mac[1],
+            mac[2],
+            mac[3],
+            mac[4],
+            mac[5]
+           );
+    return mac_str;
+}
+EXPORT_SYMBOL(knos_mac2str);
+
+int knos_split_str(char *str, char sep, char **part, int maxparts)
+{
+    int parts = 0;
+    char *p1 = str;
+    char *p2;
+
+    part[parts++] = p1;
+
+    while ((p2 = strchr (p1, sep)) && (parts < maxparts)) {
+        *p2 = 0;
+        p1 = p2 + 1;
+        part[parts++] = p1;
+    }
+
+    return parts;
+}
+EXPORT_SYMBOL(knos_split_str);
+
+
+int knos_dump_mem( char *title, void *data, unsigned int len )
+{
+    int             i;
+    unsigned char   *d = (unsigned char*)data;
+    unsigned char   dump_buf[80];
+    unsigned char   *p1, *p2;
+    unsigned char   ch;
+
+    if ( title )    printk(":::: %s ::::\n", title );
+    printk("===============================================================================\n" );
+
+    for ( i=0; i< len; i++ )
+    {
+        if((i % 16) == 0)
+        {
+            memset( dump_buf, 0x20, 80 );
+            p1 = &dump_buf[0];
+            p2 = &dump_buf[63];
+
+            p1 += sprintf( p1, "%08x  ", (unsigned long int)d );
+        }
+
+        ch = (unsigned char)(*d);
+        if( (7==(i % 16)) )
+            p1 += sprintf( p1, "%02x   ", (unsigned char)ch );
+        else
+            p1 += sprintf( p1, "%02x ", (unsigned char)ch );
+        if ( (0x20<ch) && (ch<0x7f) )   *p2 = ch;
+        else                            *p2 = '.';
+        p2++;
+        d++;
+
+        if( (15==(i % 16)) || (len<=(i+1)) )
+        {
+            *p1++ = 0x20;
+            *p1   = 0x20;
+            *p2   = '\0';
+            printk("%s\n", dump_buf);
+        }
+    } /* for */
+
+    printk("===============================================================================\n" );
+
+    return  0;
+}
+EXPORT_SYMBOL(knos_dump_mem);
