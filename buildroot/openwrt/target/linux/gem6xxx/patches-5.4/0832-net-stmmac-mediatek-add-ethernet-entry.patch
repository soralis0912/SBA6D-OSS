+static int mt2737_set_interface(struct mediatek_dwmac_plat_data *plat)
+{
+	u32 intf_val = 0, intf_val2 = 0;
+	u32 err;
+
+	const struct mediatek_dwmac_variant *variant = plat->variant;
+	regmap_read(plat->peri_regmap, MT2737_PERI_ETH_CTRL1, &intf_val);
+	regmap_read(plat->peri_regmap, MT2737_PERI_ETH_CTRL3, &intf_val2);
+
+	/* select phy interface in top control domain */
+	switch (plat->phy_mode) {
+	case PHY_INTERFACE_MODE_MII:
+		/*MII/RMII external clock*/
+		intf_val &= ~MT2737_ETH_INTF_SEL;
+		intf_val |= FIELD_PREP(MT2737_ETH_INTF_SEL, PHY_INTF_MII);
+		intf_val &= ~MT2737_ETH_TXC_SHIFT;
+		break;
+	case PHY_INTERFACE_MODE_RMII:
+		intf_val &= ~MT2737_ETH_INTF_SEL;
+		intf_val |= FIELD_PREP(MT2737_ETH_INTF_SEL, PHY_INTF_RMII);
+		intf_val &= ~MT2737_ETH_TXC_SHIFT;
+		intf_val &= ~MT2737_RMII_CLK_SEL;
+		if (plat->rmii_int_clk)
+			intf_val |= FIELD_PREP(MT2737_RMII_CLK_SEL, MT2737_RMII_CLK_INT_RXC);
+		else if (plat->rmii_rxc)
+			intf_val |= FIELD_PREP(MT2737_RMII_CLK_SEL, MT2737_RMII_CLK_EXT_RXC);
+		else
+			intf_val |= FIELD_PREP(MT2737_RMII_CLK_SEL, MT2737_RMII_CLK_EXT_TXC);
+		break;
+
+	case PHY_INTERFACE_MODE_RGMII:
+	case PHY_INTERFACE_MODE_RGMII_TXID:
+	case PHY_INTERFACE_MODE_RGMII_RXID:
+	case PHY_INTERFACE_MODE_RGMII_ID:
+		intf_val &= ~MT2737_ETH_INTF_SEL;
+		intf_val |= FIELD_PREP(MT2737_ETH_INTF_SEL, PHY_INTF_RGMII);
+		break;
+
+	default:
+		dev_err(plat->dev, "phy interface not supported\n");
+		return -EINVAL;
+	}
+
+	regmap_write(plat->peri_regmap, MT2737_PERI_ETH_CTRL1, intf_val);
+	return 0;
+}
+
+static void mt2737_delay_ps2stage(struct mediatek_dwmac_plat_data *plat)
+{
+	struct mac_delay_struct *mac_delay = &plat->mac_delay;
+
+	switch (plat->phy_mode) {
+	case PHY_INTERFACE_MODE_RGMII:
+	case PHY_INTERFACE_MODE_RGMII_TXID:
+	case PHY_INTERFACE_MODE_RGMII_RXID:
+	case PHY_INTERFACE_MODE_RGMII_ID:
+		/* 80ps per stage for RGMII */
+		mac_delay->tx_delay /= 80;
+		mac_delay->rx_delay /= 80;
+		break;
+	default:
+		dev_err(plat->dev, "phy interface not supported\n");
+		break;
+	}
+}
+
+static void mt2737_delay_stage2ps(struct mediatek_dwmac_plat_data *plat)
+{
+	struct mac_delay_struct *mac_delay = &plat->mac_delay;
+
+	switch (plat->phy_mode) {
+	case PHY_INTERFACE_MODE_RGMII:
+	case PHY_INTERFACE_MODE_RGMII_TXID:
+	case PHY_INTERFACE_MODE_RGMII_RXID:
+	case PHY_INTERFACE_MODE_RGMII_ID:
+		/* 80ps per stage for RGMII */
+		mac_delay->tx_delay *= 80;
+		mac_delay->rx_delay *= 80;
+		break;
+	default:
+		dev_err(plat->dev, "phy interface not need delay macro such as MII/RMII\n");
+		break;
+	}
+}
+
+static int mt2737_set_delay(struct mediatek_dwmac_plat_data *plat)
+{
+	struct mac_delay_struct *mac_delay = &plat->mac_delay;
+	u32 delay_val = 0, rx_delay = 0, origin_val = 0, origin_val_rx = 0;
+
+	mt2737_delay_ps2stage(plat);
+
+	regmap_read(plat->peri_regmap, MT2737_PERI_ETH_CTRL1, &origin_val);
+	delay_val = origin_val;
+
+	regmap_read(plat->peri_regmap, MT2737_PERI_ETH_CTRL2, &origin_val_rx);
+	rx_delay = origin_val_rx;
+
+	switch (plat->phy_mode) {
+	case PHY_INTERFACE_MODE_RGMII:
+	case PHY_INTERFACE_MODE_RGMII_TXID:
+	case PHY_INTERFACE_MODE_RGMII_RXID:
+	case PHY_INTERFACE_MODE_RGMII_ID:
+		delay_val &= ~(MT2737_DLY_GTXC_FINE_EN | MT2737_DLY_GTXC_INV | MT2737_DLY_GTXC_FINE_STG);
+
+		delay_val |= FIELD_PREP(MT2737_DLY_GTXC_FINE_EN, !!mac_delay->tx_delay);
+		delay_val |= FIELD_PREP(MT2737_DLY_GTXC_FINE_STG, mac_delay->tx_delay);
+		delay_val |= FIELD_PREP(MT2737_DLY_GTXC_INV, mac_delay->tx_inv);
+
+		rx_delay &= ~(MT2737_DLY_RXC_FINE_EN | MT2737_DLY_RXC_INV | MT2737_DLY_RXC_FINE_STG);
+		rx_delay |= FIELD_PREP(MT2737_DLY_RXC_FINE_EN, !!mac_delay->rx_delay);
+		rx_delay |= FIELD_PREP(MT2737_DLY_RXC_FINE_STG, mac_delay->rx_delay);
+		rx_delay |= FIELD_PREP(MT2737_DLY_RXC_INV, mac_delay->rx_inv);
+		break;
+	default:
+		dev_err(plat->dev, "phy interface not need delay macro such as MII/RMII\n");
+		return -EINVAL;
+	}
+
+	regmap_write(plat->peri_regmap, MT2737_PERI_ETH_CTRL1, delay_val);
+	regmap_write(plat->peri_regmap, MT2737_PERI_ETH_CTRL2, rx_delay);
+
+	mt2737_delay_stage2ps(plat);
+
+	return 0;
+}
+
+static const struct mediatek_dwmac_variant mt2737_gmac_variant = {
+	.dwmac_set_phy_interface = mt2737_set_interface,
+	.dwmac_set_delay = mt2737_set_delay,
+	.clk_list = mt2737_dwmac_clk_l,
+	.num_clks = ARRAY_SIZE(mt2737_dwmac_clk_l),
+	.dma_bit_mask = 32,
+	.rx_delay_max = 2800,
+	.tx_delay_max = 2800,
+};
