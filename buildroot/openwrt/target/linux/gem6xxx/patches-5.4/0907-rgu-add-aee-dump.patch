+
+void dump_watchdog_dev_info(void)
+{
+	struct hrtimer *wdd_timer;
+	struct kthread_work *work = NULL;
+
+	if (old_wd_data && old_wd_data->wdd && watchdog_active(old_wd_data->wdd)) {
+		aee_log("watchdog ping is taken by user space process\n");
+	} else {
+		if (watchdog_kworker) {
+		    aee_log("watchdog_kworker flags: 0x%x, comm: %s\n", watchdog_kworker->flags, watchdog_kworker->task->comm);
+			if (!list_empty(&watchdog_kworker->work_list)) {
+				work = list_first_entry(&watchdog_kworker->work_list,
+					struct kthread_work, node);
+				aee_log("watchdog_work %pF\n", work->func);
+			} else {
+				aee_log("watchdog_work empty\n");
+			}
+			if (watchdog_kworker->current_work) {
+				aee_log("current_work fn: %pF\n", watchdog_kworker->current_work->func);
+			}
+		}
+		if (old_wd_data && old_wd_data->wdd && old_wd_data->wdd->wd_data) {
+			wdd_timer = &old_wd_data->wdd->wd_data->timer;
+			aee_log("wdd timer next expired: %lld(%lld), state %d, fn: %pF\n", ktime_to_ns(wdd_timer->_softexpires), ktime_to_ns(wdd_timer->node.expires), wdd_timer->state, wdd_timer->function);
+		}
+	}
+}
+#endif
