+#ifdef CONFIG_DEBUG_FS
+int mmd_write(struct stmmac_priv *priv, struct phy_device *phy_dev, int devaddr, int reg, int data)
+{
+	priv->mii->write(priv->mii, phy_dev->mdio.addr,
+				 0xd, devaddr);
+
+	priv->mii->write(priv->mii, phy_dev->mdio.addr,
+				 0xe, reg);
+
+	priv->mii->write(priv->mii, phy_dev->mdio.addr,
+				 0xd, (1 << 14) | devaddr);
+
+	priv->mii->write(priv->mii, phy_dev->mdio.addr,
+				 0xe, data);
+	return 0;
+}
+
+int mmd_read(struct stmmac_priv *priv, struct phy_device *phy_dev, int devaddr, int reg)
+{
+	int origin;
+	priv->mii->write(priv->mii, phy_dev->mdio.addr,
+				 0xd, devaddr);
+
+	priv->mii->write(priv->mii, phy_dev->mdio.addr,
+				 0xe, reg);
+
+	priv->mii->write(priv->mii, phy_dev->mdio.addr,
+				 0xd, (1 << 14) | devaddr);
+
+	origin = priv->mii->read(priv->mii, phy_dev->mdio.addr, 0xe);
+
+	return origin;
+}
