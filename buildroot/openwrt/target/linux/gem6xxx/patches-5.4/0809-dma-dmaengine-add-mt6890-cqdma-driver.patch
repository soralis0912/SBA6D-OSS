-
-	dma_async_device_unregister(&cqdma->ddev);
-	of_dma_controller_free(pdev->dev.of_node);
+	devm_kfree(&pdev->dev, cqdma->vc);
+	for (i = 0; i < cqdma->dma_channels; ++i)
