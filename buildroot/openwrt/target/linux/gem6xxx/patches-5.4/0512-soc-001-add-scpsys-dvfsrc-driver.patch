+
+	if(strcmp(genpd->name,"pcie0")==0 || strcmp(genpd->name,"pcie0_skip")==0){
+		ctl_addr_phy1 = scp->base + 0x0E74;
+		ctl_addr_phy2 = scp->base + 0x0E78;
+	}else if (strcmp(genpd->name,"pcie1")==0){
+		ctl_addr_phy1 = scp->base + 0x0E64;
+		ctl_addr_phy2 = scp->base + 0x0E64;
+	}else {
+		ctl_addr_phy1 = scp->base + 0x0E6C;
+		ctl_addr_phy2 = scp->base + 0x0E6C;
+	}
+	//pr_notice("phy1 = %x, phy2 = %x \n",ctl_addr_phy1,ctl_addr_phy2);
+
+	//ret = scpsys_bus_protect_enable(scpd);
+	//if (ret < 0)
+	//	goto out;
+	//pr_notice("scpsys_bus_protect_enable pass \n");
+//slpprot
+	if(strcmp(genpd->name,"pcie0")==0 || strcmp(genpd->name,"pcie0_skip")==0){
+		val = readl(slp_addr);
+		val |= 0x00000800;
+		writel(val, slp_addr);
+	} else if(strcmp(genpd->name,"pcie1")==0){
+		regmap_read(peri_base,0x0B74,&val);
+		val |= 0x00000001;
+		regmap_write(peri_base,0x0B74,val);
+		regmap_read(peri_base,0x0B70,&val);
+		val |= 0x00000001;
+		regmap_write(peri_base,0x0B70,val);
+	} else {
+		regmap_read(peri_base,0x0B74,&val);
+		val |= 0x00000002;
+		regmap_write(peri_base,0x0B74,val);
+		regmap_read(peri_base,0x0B70,&val);
+		val |= 0x00000002;
+		regmap_write(peri_base,0x0B70,val);
+	}
+	//pr_notice("scpsys_bus_protect_enable pass \n");
+
+	/* pcie sram no need to wait ack*/
+	val = readl(ctl_addr) | scpd->data->sram_pdn_bits;
+	writel(val, ctl_addr);
+
+	//pr_notice("scpsys_sram_disable pass \n");
+	val = readl(ctl_addr_phy1);
+	val |= PWR_ISO_BIT;
+	writel(val, ctl_addr_phy1);
+	val = readl(ctl_addr_phy2);
+	val |= PWR_ISO_BIT;
+	writel(val, ctl_addr_phy2);
+//ana_addr
+	val = readl(ana_addr);
+	if(strcmp(genpd->name,"pcie0")==0 || strcmp(genpd->name,"pcie0_skip")==0)
+		val &= ~(0x00000100);
+	else if(strcmp(genpd->name,"pcie1")==0)
+		val &= ~(0x00000040);
+	else
+		val &= ~(0x00000080);
+
+	writel(val, ana_addr);
+//ana_addr
+	val = readl(ctl_addr);
+	val |= PWR_ISO_BIT;
+	writel(val, ctl_addr);
+
+	//pr_notice("PWR_ISO_BIT pass \n");
+	val = readl(ctl_addr);
+	val |= PWR_CLK_DIS_BIT;
+	writel(val, ctl_addr);
+	val = readl(ctl_addr_phy1);
+	val |= PWR_CLK_DIS_BIT;
+	writel(val, ctl_addr_phy1);
+	val = readl(ctl_addr_phy2);
+	val |= PWR_CLK_DIS_BIT;
+	writel(val, ctl_addr_phy2);
+
+	//pr_notice("PWR_CLK_DIS_BIT pass \n");
+	val = readl(ctl_addr);
+	val &= ~PWR_RST_B_BIT;
+	writel(val, ctl_addr);
+	val = readl(ctl_addr_phy1);
+	val &= ~PWR_RST_B_BIT;
+	writel(val, ctl_addr_phy1);
+	val = readl(ctl_addr_phy2);
+	val &= ~PWR_RST_B_BIT;
+	writel(val, ctl_addr_phy2);
+
+	//pr_notice("PWR_RST_B_BIT pass \n");
+	val = readl(ctl_addr);
+	val &= ~PWR_ON_BIT;
+	writel(val, ctl_addr);
+	val = readl(ctl_addr_phy1);
+	val &= ~PWR_ON_BIT;
+	writel(val, ctl_addr_phy1);
+	val = readl(ctl_addr_phy2);
+	val &= ~PWR_ON_BIT;
+	writel(val, ctl_addr_phy2);
+
+	//pr_notice("PWR_ON_BIT pass \n");
+	val = readl(ctl_addr);
+	val &= ~PWR_ON_2ND_BIT;
+	writel(val, ctl_addr);
+	val = readl(ctl_addr_phy1);
+	val &= ~PWR_ON_2ND_BIT;
+	writel(val, ctl_addr_phy1);
+	val = readl(ctl_addr_phy2);
+	val &= ~PWR_ON_2ND_BIT;
+	writel(val, ctl_addr_phy2);
+
+	//pr_notice("PWR_ON_2ND_BIT pass \n");
+	/* wait until PWR_ACK = 1 */
+	if (MTK_SCPD_CAPS(scpd, MTK_SCPD_IS_PWR_CON_ON))
+		ret = readx_poll_timeout_atomic(scpsys_pwr_con_is_on, scpd, tmp, tmp == 0,
+				MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+	else
+		ret = readx_poll_timeout_atomic(scpsys_domain_is_on, scpd, tmp, tmp == 0,
+				MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+	if (ret < 0)
+		goto out;
+
+	scpsys_clk_disable(scpd->clk, MAX_CLKS);
+
+	//pr_notice("MTK_SCPD_IS_PWR_CON_ON pass \n");
+	ret = scpsys_regulator_disable(scpd);
+	if (ret < 0)
+		goto out;
+
+	return 0;
+
+out:
+	dev_err(scp->dev, "Failed to power off domain %s\n", genpd->name);
+
+	return ret;
+}
