+		bc_dump_buf_append(bc_dump_buf,
+			", f: %*pbl",
+			cpumask_pr_args(&_tb_dbg_force_mask));
+		bc_dump_buf_append(bc_dump_buf,
+			", t: ");
+		for (i = 0; i < NR_CPUS; i++) {
