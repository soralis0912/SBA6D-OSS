--- linux-5.4.179.orig/drivers/clk/mediatek/Kconfig	2022-05-16 22:39:39.901445000 +0800
+++ linux-5.4.179/drivers/clk/mediatek/Kconfig	2022-05-16 22:47:00.000000000 +0800
@@ -331,6 +331,98 @@
 	  If you wish to use clock resources from the mmsys_config device,
 	  say Y. Otherwise, say N.
 
+config COMMON_CLK_MT6990
+	tristate "Clock driver for MediaTek MT6990"
+	depends on ARM64 || COMPILE_TEST
+	select COMMON_CLK_MEDIATEK
+	default MACH_MT6990
+	help
+	  This driver supports MediaTek MT6990 basic clocks,
+	  which is used to control basic clock output.
+	  If you wish to use clock resources from the MT6990 SOC,
+	  say Y. Otherwise, say N.
+
+config COMMON_CLK_MT6990_AFE
+	tristate "Clock driver for MediaTek MT6990 afe"
+	depends on COMMON_CLK_MT6990
+	help
+	  This driver supports MediaTek MT6990 afe clocks,
+	  which is used to control afe clock output.
+	  If you wish to use clock resources from the afe device,
+	  say Y. Otherwise, say N.
+
+config COMMON_CLK_MT6990_DBG
+	tristate "Clock driver for MediaTek MT6990 dbg"
+	depends on COMMON_CLK_MT6990
+	help
+	  This driver supports MediaTek MT6990 dbg clocks,
+	  which is used to control dbg clock output.
+	  If you wish to use clock resources from the dbg device,
+	  say Y. Otherwise, say N.
+
+config COMMON_CLK_MT6990_GCE
+	tristate "Clock driver for MediaTek MT6990 gce"
+	depends on COMMON_CLK_MT6990
+	help
+	  This driver supports MediaTek MT6990 gce clocks,
+	  which is used to control gce clock output.
+	  If you wish to use clock resources from the gce device,
+	  say Y. Otherwise, say N.
+
+config COMMON_CLK_MT6990_INFRACFG_AO
+	tristate "Clock driver for MediaTek MT6990 infracfg_ao"
+	depends on COMMON_CLK_MT6990
+	help
+	  This driver supports MediaTek MT6990 infracfg_ao clocks,
+	  which is used to control infracfg_ao clock output.
+	  If you wish to use clock resources from the infracfg_ao device,
+	  say Y. Otherwise, say N.
+
+config COMMON_CLK_MT6990_MMSYS
+	tristate "Clock driver for MediaTek MT6990 mmsys"
+	depends on COMMON_CLK_MT6990
+	help
+	  This driver supports MediaTek MT6990 mmsys clocks,
+	  which is used to control mmsys clock output.
+	  If you wish to use clock resources from the mmsys device,
+	  say Y. Otherwise, say N.
+
+config COMMON_CLK_MT6990_MFG_TOP
+	tristate "Clock driver for MediaTek MT6990 mfg_top"
+	depends on COMMON_CLK_MT6990
+	help
+	  This driver supports MediaTek MT6990 mfg_top clocks,
+	  which is used to control mfg_top clock output.
+	  If you wish to use clock resources from the mfg_top device,
+	  say Y. Otherwise, say N.
+
+config COMMON_CLK_MT6990_PERI
+	tristate "Clock driver for MediaTek MT6990 peri"
+	depends on COMMON_CLK_MT6990
+	help
+	  This driver supports MediaTek MT6990 peri clocks,
+	  which is used to control peri clock output.
+	  If you wish to use clock resources from the peri device,
+	  say Y. Otherwise, say N.
+
+config COMMON_CLK_MT6990_SSPM_CFG
+	tristate "Clock driver for MediaTek MT6990 sspm_cfg"
+	depends on COMMON_CLK_MT6990
+	help
+	  This driver supports MediaTek MT6990 sspm_cfg clocks,
+	  which is used to control sspm_cfg clock output.
+	  If you wish to use clock resources from the sspm_cfg device,
