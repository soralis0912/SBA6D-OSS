+#if _MTK_SPI_TEST_MODE_
+	spi_debug("chip_config->tx_mlsb:%d.\n", chip_config->tx_mlsb);
+	spi_debug("chip_config->rx_mlsb:%d.\n", chip_config->rx_mlsb);
+	spi_debug("chip_config->deassert_mode=%d\n",
