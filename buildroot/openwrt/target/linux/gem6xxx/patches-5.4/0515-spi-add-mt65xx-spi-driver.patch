+	spi_debug("||**************%s**************||\n", __func__);
+	spi_debug("chip_config->spi_mode:0x%x\n", spi->mode & ~SPI_CS_HIGH);
+	spi_debug("chip_config->cs_pol:%d.\n", (spi->mode & SPI_CS_HIGH)?1:0);
