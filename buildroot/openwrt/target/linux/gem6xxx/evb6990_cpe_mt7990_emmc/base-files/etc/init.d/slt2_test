#!/bin/sh /etc/rc.common
START=99
STOP=1

USE_PROCD=1
start_service() {
	[ -e /sys/bus/platform/drivers/slt_reboot/report ] && {
		echo "slt_print_time_sh"
		procd_open_instance
		procd_set_param command /usr/bin/slt_print_time_sh
		procd_set_param limits core="unlimited"
		procd_set_param respawn
		# forward stdout and stderr of the command to logd
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance

		echo "slt_print_time_sh"
		procd_open_instance
		procd_set_param command /usr/bin/dvfs_300m_sh
		procd_set_param limits core="unlimited"
		procd_set_param respawn
		# forward stdout and stderr of the command to logd
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance

		echo 1 > /proc/mtprintk
		echo "SLT boot_completed" > /sys/bus/platform/drivers/slt_reboot/report

		procd_open_instance
		procd_set_param command /usr/bin/slt_sh
		procd_set_param limits core="unlimited"
		procd_set_param respawn
		# forward stdout and stderr of the command to logd
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	}
}
reload_service()
{
	[ -e /sys/bus/platform/drivers/slt_reboot/report ] && {
		echo "slt script reload_service"
		stop
		start
	}
}

service vcore_dvfs_stress
service slt_print_time
