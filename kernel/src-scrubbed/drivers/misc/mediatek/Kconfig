config MTK_CORE_NUM
        int "MTK CPU Core Num"
        default 4
        help
          Set the total cpu of the platform.
          Possible value are 2, 4.
          Default configuration is 4.

menu "Config File"
config BUILD_CONFIG_FILE
	string "build config file"
	help
	  Specify the build.config file which record toolchain environment
	  Such as "build.config.mtk.aarch64"
endmenu # Config

