			mediatek,fh-pll-id = <CLK_APMIXED_MFGPLL>;
		};

		mmpll {
			mediatek,fh-id = <5>;
			mediatek,fh-pll-id = <CLK_APMIXED_MMPLL>;
		};

		mpll {
			mediatek,fh-id = <6>;
