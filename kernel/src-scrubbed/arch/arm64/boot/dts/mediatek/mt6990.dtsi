#ifndef CONFIG_QL_FCM360W_WIFI
	sound: sound {
		compatible = "mediatek,mt6990-slic-sound";
		mediatek,platform = <&afe>;
		mediatek,ext-codec {
			sound-dai = <&proslic_spi>;
		};
		mediatek,ext-codec1 {
			sound-dai = <&proslic_spi0>;
		};
	};
#endif

	audio_sram@11211000 {
		compatible = "mediatek,audio_sram";
		reg = <0 0x11211000 0 0x10000>;
		prefer_mode = <1>;
		mode_size = <0xC000 0x10000>;
		block_size = <0x1000>;
	};

	touch: touch {
	};

	rt9465_slave_chr: rt9465_slave_chr {
	};

	accdet: accdet {
	};

	smart_pa: smart_pa {
	};

	consys: consys@18000000 {
		compatible = "mediatek,mt6990-consys-atf";
		#thermal-sensor-cells = <0>;
		reg = <0 0x10001000 0 0xf68>, /* 0. infracfg_ao */
			<0 0x10004000 0 0xa7c>, /* 1. GPIO */
			<0 0x11d20000 0 0xa04>, /* 2. IOCFG_BM_6 */
			<0 0x12001000 0 0xfb0>, /* 3. spm */
			<0 0x18000000 0 0x470>, /* 4. conn_infra_rgu_on */
			<0 0x18001000 0 0x658>, /* 5. conn_infra_cfg_on */
			<0 0x18003000 0 0x204>, /* 6. conn_wt_slp_ctl_reg */
			<0 0x1800e000 0 0x124>, /* 7. conn_infra_bus_cr_on */
			<0 0x18011000 0 0x138>, /* 8. conn_infra_cfg */
			<0 0x18012000 0 0x98>,  /* 9. conn_infra_clkgen_top */
			<0 0x18020000 0 0x4c>,  /* 10. conn_von_bus_bcrm */
			<0 0x18023000 0 0xe28>, /* 11. conn_dbg_ctl */
			<0 0x1803b000 0 0x18>,  /* 12. conn_infra_on_bus_bcrm */
			<0 0x18040000 0 0x2c>,  /* 13. conn_therm_ctl */
			<0 0x18041000 0 0x140>, /* 14. conn_afe_ctl */
			<0 0x18042000 0 0x324>, /* 15. conn_rf_spi_mst_reg */
			<0 0x1804b000 0 0x414>, /* 16. conn_infra_bus_cr */
			<0 0x1804d000 0 0x41c>, /* 17. conn_infra_off_debug_ctrl_ao */
			<0 0x1804f000 0 0x148>, /* 18. conn_infra_off_bus_bcrm */
			<0 0x18051000 0 0x1000>,/* 19. conn_infra_sysram_sw_cr */
			<0 0x18060000 0 0xbf8>, /* 20. conn_host_csr_top */
			<0 0x18070000 0 0x7004>;/* 21. conn_semaphore */
		power-domains = <&scpsys MT6990_POWER_DOMAIN_CONN_ON>;
		emi-addr = <0>;
		emi-size = <0>;
		fw-binary-size = <0x80000>;
		fw-data-size = <0>;
		ap-shared-size = <0x78000>;
		ap-no-perm-size = <0>;
		gps-emi-offset = <0x80000>;
		emi-alignment = <0x10000>;
		emi-max-addr = <0xffffffff>;
		radio-support = "gps";
		tcxo_support = "false";
	};

        firmware {
                optee {
                        compatible = "linaro,optee-tz";
                        method = "smc";
                };
        };

	met {
	met_emi: met_emi {
		compatible = "mediatek,met_emi";
		emi_num = <1>;
		dram_num = <2>;
		dramc_ver = <2>;
		/* 0: dram ebg, 1:emi_freq, 2: DRAMC_DCM_CTRL 3:chn_emi_low_effi */
		/* 4: SLC */
		met_emi_support_list = <0x5>;
		cen_emi_reg_base = <0x10217000>;
		cen_emi_reg_size = <0x1000>;
		chn_emi_reg_base = <0x10235000 0x10245000>;
		chn_emi_reg_size = <0x1000>;
		dramc_nao_reg_base = <0x10234000 0x10244000>;
		dramc_nao_reg_size = <0x1000>;
		dramc_ao_reg_base = <0x10230000 0x10240000>;
		dramc_ao_reg_size = <0x2000>;
		ddrphy_ao_reg_base = <0x10238000 0x10248000>;
		ddrphy_ao_reg_size = <0x2000>;
		ddrphy_ao_misc_cg_ctrl0 = <0x70C>;
		ddrphy_ao_misc_cg_ctrl2 = <0x714>;
		dram_freq_default = <6400>;
		ddr_ratio_default = <8>;
		dram_type_default = <8>;
		apmixedsys_reg_base = <0x1000C000>;
		apmixedsys_reg_size = <0x410>;
		slc_pmu_reg_base = <0x10342000 0x10343000>;
		slc_pmu_reg_size = <0x1000>;
	};
};
};


&spmi_bus {
	/* TODO: temp change slv from 4 to 6 for mt6330 co-exist */
	pmic: mt6361@4 {
		compatible = "mediatek,mt6361";
		reg = <0x4 SPMI_USID 0xb SPMI_GSID>;
		interrupts = <4>;
		#address-cells = <1>;
		#size-cells = <0>;
		interrupt-controller;
		#interrupt-cells = <1>;
		pmic_auxadc: adc {
			compatible = "mediatek,mt6361-adc";
			#io-channel-cells = <1>;
		};
		pmic_efuse: efuse {
			compatible = "mediatek,mt6361-efuse";
			#address-cells = <1>;
			#size-cells = <1>;
			thermal_efuse_data1: t_e_6361@0 {
				reg = <0 12>;
			};
		};
		led-controller {
			compatible = "mediatek,mt6361-isink";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <MT6361_FLAG_ISINK1_SHORT>,
				     <MT6361_FLAG_ISINK1_OPEN>,
				     <MT6361_FLAG_ISINK2_SHORT>,
				     <MT6361_FLAG_ISINK2_OPEN>,
				     <MT6361_FLAG_ISINK3_SHORT>,
				     <MT6361_FLAG_ISINK3_OPEN>;
			interrupt-names = "isink1_short", "isink1_open",
					  "isink2_short", "isink2_open",
					  "isink3_short", "isink3_open";

			led@0 {
				reg = <0>;
				label = "5g_evb_air_plane";
				led-max-microamp = <12000>;
				linux,default-trigger = "none";
				default-state = "off";
				soft-start-en = <1>;
			};
			led@1 {
				reg = <1>;
				label = "5g_evb_net_status";
				led-max-microamp = <12000>;
				linux,default-trigger = "none";
				default-state = "off";
				soft-start-en = <1>;
			};
			/*	modified by quectel,RG620T-SBK use gpio16 to control system led replace isink3
			led@2 {
				reg = <2>;
				label = "5g_evb_system";
				led-max-microamp = <12000>;
				linux,default-trigger = "none";
				default-state = "off";
				soft-start-en = <1>;

			};*/
		};
		keys {
			compatible = "mediatek,mt6361-keys";
			interrupts = <MT6361_FLAG_PWRKEY>,
				     <MT6361_FLAG_PWRKEY_LP>,
				     <MT6361_FLAG_PWRKEY_SP>,
				     <MT6361_FLAG_PMIC_RESETB_LP>,
				     <MT6361_FLAG_PMIC_RESETB_SP>;
			interrupt-names = "pwrkey", "pwrkey_lp", "pwrkey_sp",
					  "pmic_resetb_lp", "pmic_resetb_sp";
			resetb_sp_tsel = <1>; /* 0.5/1/2/3 sec */
			resetb_sp_mode = <2>;
			/* [short press mode]
			 * 0: interupt only
			 * 1: pmic rg reset
			 * 2: sysrstb: low -> 8ms -> high
			 * 3: warm reset: pmic rg reset and sysrstb: low -> 8ms -> high
			 */
			resetb_lp_tsel = <3>; /* 4/6/8/10/12/14/16/18 sec */
			resetb_lp_mode = <0>;
			/* [long press mode]
			 * 0: interupt only
			 * 1: exception shutdown and pmic rg reset
			 * 2: seq-off -> reset pmic rg
			 * 3: cold reset:
			 *    seq-off and reset pmic rg -> min-off time -> reboot
			 * 4: sysrstb: low -> 8ms -> high
			 */
			pwrkey_sp_tsel = <0>; /* 0.5/1/2/3 sec */
			pwrkey_sp_mode = <0>;
			pwrkey_lp_tsel = <2>; /* 4/6/8/10/12/14/16/18 sec */
			pwrkey_lp_mode = <1>;
		};
		dbg {
			compatible = "mediatek,mt6361-dbg";
		};
		pinctrl: pinctrl {
			compatible = "mediatek,mt6361-pinctrl";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 0 12>;
		};

		mt6361-consys {
			compatible = "mediatek,mt6361-consys";
		};

