		compatible = "mediatek,mt69xx-pinctrl";
		reg = <0 0x10004000 0 0x1000>,
			<0 0x11c00000 0 0x1000>,
			<0 0x11c10000 0 0x1000>,
			<0 0x11d00000 0 0x1000>,
			<0 0x11d10000 0 0x1000>,
