			"iocfg_bm_6", "iocfg_bm_7",
			"iocfg_lt_0","iocfg_lt_1",
			"iocfg_lt_3";
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&pio 0 0 226>;
		interrupt-controller;
		#interrupt-cells = <2>;
		mediatek,eint = <&eint>;
	};

