	pcie0: pcie@11280000 {
		compatible = "mediatek,mt6990-pcie";
		reg = <0 0x11280000 0 0x2000>;
		reg-names = "pcie-mac";
		linux,pci-domain = <0>;
		#address-cells = <3>;
		#size-cells = <2>;
		interrupts = <GIC_SPI 288 IRQ_TYPE_LEVEL_HIGH>;
		bus-range = <0x00 0xff>;
		ranges = <0x82000000 0 0x30000000
			  0x0 0x30000000 0 0x10000000>;
		phys = <&pciephy0>;
		phy-names = "pcie-phy";
		status = "disabled";

		clocks = <&pericfg_ao_clk CLK_PERAO_PERI2PCIE0__TX>,
			<&vlpcfg_clk CLK_VLPCFG_PCIE_TL_32K>,
			<&vlpcfg_clk CLK_VLPCFG_PCIE_TL_26M>,
			<&vlpcfg_clk CLK_VLPCFG_PCIE_TL_96M>,
			<&vlpcfg_clk CLK_VLPCFG_PCIE_TL_ULPOSC>,
			<&vlpcfg_clk CLK_VLPCFG_PCIE_REF_CK_26M>,
			<&vlpcfg_clk CLK_VLPCFG_PCIE_AXI250>,
			<&vlpcfg_clk CLK_VLPCFG_PCIE_SRAM_26M>,
			<&vlp_cksys_clk CLK_VLP_CK_TL_VLP_SEL>;

		power-domains = <&scpsys MT6990_POWER_DOMAIN_PCIE0>;

		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie_intc0 0>,
				<0 0 0 2 &pcie_intc0 1>,
				<0 0 0 3 &pcie_intc0 2>,
				<0 0 0 4 &pcie_intc0 3>;
		pcie_intc0: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};

	pcie1: pcie@11288000 {
		compatible = "mediatek,mt6990-pcie";
		reg = <0 0x11288000 0 0x2000>;
		reg-names = "pcie-mac";
		linux,pci-domain = <1>;
		#address-cells = <3>;
		#size-cells = <2>;
		interrupts = <GIC_SPI 278 IRQ_TYPE_LEVEL_HIGH>;
		bus-range = <0x00 0xff>;
		ranges = <0x82000000 0 0x40000000
			  0x0 0x40000000 0 0x04000000>;
		phys = <&pciephy1>;
		phy-names = "pcie-phy";
		status = "disabled";

		clocks = <&pericfg_ao_clk CLK_PERAO_PCIE_2LX1_TL>,
			 <&pericfg_ao_clk CLK_PERAO_PCIE_2LX1_REF>,
			<&pericfg_ao_clk CLK_PERAO_PCIE_2LX1_AXI>,
			<&pericfg_ao_clk CLK_PERAO_PCIE_2LX1_AHB>,
			<&pericfg_ao_clk CLK_PERAO_PCIE_2LX1_26M>,
			<&topckgen_clk CLK_TOP_TL_SEL>,
			<&topckgen_clk CLK_TOP_PCIE_250M_SEL>;

		power-domains = <&scpsys MT6990_POWER_DOMAIN_PCIE1>;

		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie_intc1 0>,
				<0 0 0 2 &pcie_intc1 1>,
				<0 0 0 3 &pcie_intc1 2>,
				<0 0 0 4 &pcie_intc1 3>;
		pcie_intc1: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};

	pcie2: pcie@11290000 {
		compatible = "mediatek,mt6990-pcie";
		reg = <0 0x11290000 0 0x2000>;
		reg-names = "pcie-mac";
		linux,pci-domain = <2>;
		#address-cells = <3>;
		#size-cells = <2>;
		interrupts = <GIC_SPI 279 IRQ_TYPE_LEVEL_HIGH>;
		bus-range = <0x00 0xff>;
		ranges = <0x82000000 0 0x44000000
			  0x0 0x44000000 0 0x04000000>;
		phys = <&pciephy2>;
		phy-names = "pcie-phy";
		status = "disabled";

		clocks = <&pericfg_ao_clk CLK_PERAO_PCIE_2LX2_TL>,
			<&pericfg_ao_clk CLK_PERAO_PCIE_2LX2_REF>,
			<&pericfg_ao_clk CLK_PERAO_PCIE_2LX2_AXI>,
			<&pericfg_ao_clk CLK_PERAO_PCIE_2LX2_AHB>,
			<&pericfg_ao_clk CLK_PERAO_PCIE_2LX2_26M>,
			<&topckgen_clk CLK_TOP_TL_SEL>,
			<&topckgen_clk CLK_TOP_PCIE_250M_SEL>;

		power-domains = <&scpsys MT6990_POWER_DOMAIN_PCIE2>;

		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie_intc2 0>,
				<0 0 0 2 &pcie_intc2 1>,
				<0 0 0 3 &pcie_intc2 2>,
				<0 0 0 4 &pcie_intc2 3>;
		pcie_intc2: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};

