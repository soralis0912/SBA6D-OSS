	dbi0: dbi0@1400f000 {
		compatible = "mediatek,mt6990-dbi0";
		reg = <0 0x1400f000 0 0x1000>;
		interrupts = <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&mdpsys_config_clk CLK_MDP_DISP_DBPI0>,
			//<&infracfg_ao_clk CLK_PERAO_NFI_BCLK>,	//NFI and DBI-B co-exist
			<&clk_null>,
			<&topckgen_clk CLK_TOP_NFI1X_SEL>,	    //NFI and DBI-B co-exist
			<&topckgen_clk CLK_TOP_TCK_26M_MX9>,    //26M
			<&topckgen_clk CLK_TOP_UNIVPLL_D5_D4>,  //125M
			<&topckgen_clk CLK_TOP_MAINPLL_D7_D4>,  //78M
			<&topckgen_clk CLK_TOP_MAINPLL_D6_D4>,  //91M
			<&topckgen_clk CLK_TOP_UNIVPLL_D6_D4>,  //104M
			<&topckgen_clk CLK_TOP_MAINPLL_D4_D4>,  //137M
			<&topckgen_clk CLK_TOP_UNIVPLL_D4_D4>,  //156M
			<&topckgen_clk CLK_TOP_MAINPLL_D6_D2>,  //182M
			<&mdpsys_config_clk CLK_MDP_SMI_COMMON>,
			<&mdpsys_config_clk CLK_MDP_DISP_DBPI0_1>,
			<&topckgen_clk CLK_TOP_DBI_SEL>;		//Separate DBI-B data pin
		clock-names = "clk_mm_dbpi",
			"clk_infra_nfi",
			"clk_engine",
			"clk_top_26",
			"clk_top_125",
			"clk_top_78",
			"clk_top_91",
			"clk_top_104",
			"clk_top_137",
			"clk_top_156",
			"clk_top_182",
			"clk_smi_common",
			"clk_mm_dbi",
			"clk_dbi_sel";
	};

	dsi_te: dsi_te {
		compatible = "mediatek, dsi_te-eint";
		status = "disabled";
	};

 	dispsys: dispsys {
 		compatible = "mediatek,dispsys";

//  Need to update to MT6990 clock, modified by Pei-hsuan Cheng
		power-domains = <&scpsys MT6990_POWER_DOMAIN_DISP>;

	    clocks = <&mdpsys_config_clk CLK_MDP_MUTEX0>,
	          <&mdpsys_config_clk CLK_MDP_APB_BUS>,
	          <&mdpsys_config_clk CLK_MDP_RSZ0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_GAMMA0>,
	          <&mdpsys_config_clk CLK_MDP_WROT0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_COLOR0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_CCORR0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_AAL0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_RDMA0>,
	          <&mdpsys_config_clk CLK_MDP_RDMA0>,
	          <&mdpsys_config_clk CLK_MDP_FAKE_ENG0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_DITHER0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_WDMA0>,
	          <&mdpsys_config_clk CLK_MDP_TDSHP0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_OVL0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_DBPI0>,
	          <&mdpsys_config_clk CLK_MDP_DISP_DSI0>,
	          <&mdpsys_config_clk CLK_MDP_SMI_COMMON>,

	          <&clk26m>,
	          <&clk32k>;


	    clock-names = "CLK_MMSYS_MUTEX0",
	          "CLK_MMSYS_APB_BUS",
	          "CLK_DISP_RSZ",
	          "CLK_DISP_GAMMA0",
	          "CLK_MM_MDP_WROT0",
	          "CLK_DISP_COLOR0",
	          "CLK_DISP_CCORR0",
	          "CLK_DISP_AAL0",
	          "CLK_DISP_RDMA0",
	          "CLK_MM_MDP_RDMA0",
	          "CLK_MMSYS_FAKE_ENG0",
	          "CLK_DISP_DITHER0",
	          "CLK_DISP_WDMA0",
	          "CLK_MM_MDP_TDSHP0",
	          "CLK_DISP_OVL0",
	          "CLK_MM_DBPI0",
	          "CLK_DSI0_MM_CK",
	          "CLK_MMSYS_SMI_COMMON",

	          "CLK_26M",
	          "CLK_32K";
 	};

	mipi_tx_config0: mipi_tx_config@11c20000 {
		compatible = "mediatek,mipi_tx_config0",
					"mediatek,mt6990-mipi-tx";
		reg = <0 0x11c20000 0 0x1000>;
		clocks = <&clk26m>;
		#clock-cells = <0>;
		#phy-cells = <0>;
		clock-output-names = "mipi_tx0_pll";
	};

	smi_sub_common0@14010000 {
		//compatible = "mediatek,smi_sub_common0";
		compatible = "mediatek,mt6880-smi-common";
		reg = <0 0x14010000 0 0x1000>;
	};


	smi_common: smi@14016000 {
		// compatible = "mediatek,smi_common0";    // use it to avoid crash.
		compatible = "mediatek,mt6880-smi-common";
		reg = <0 0x14016000 0 0x1000>;
	};

	smi_larb0: smi_larb0@14017000 {
		//compatible = "mediatek,smi_larb0";
		compatible = "mediatek,mt6880-smi-larb";
		mediatek,smi = <&smi_common>;  // suggestion from Yi Kuo
		reg = <0 0x14017000 0 0x1000>;
		mediatek,larb-id = <0>;
	};

	iommu0: iommu@14011000 {
		compatible = "mediatek,mt6880-m4u";
		reg = <0 0x14011000 0 0x1000>;
		mediatek,larbs = <&smi_larb0>;
		interrupts = <GIC_SPI 312 IRQ_TYPE_LEVEL_HIGH>;
#if 0
		clocks = <&dispsys_config MM_SMI_INFRA>,
		       <&dispsys_config MM_SMI_IOMMU>,
		       <&scpsys SCP_SYS_DIS>;
		clock-names = "disp-infra-ck", "disp-iommu-ck", "power";
#endif
		#iommu-cells = <1>;
	};

	mtk_iommu_debug {
		compatible = "mediatek,mt6880-iommu-debug";
#if 0
		iommus = <&iommu0 M4U_PORT_OVL_RDMA0>,
			 <&iommu0 M4U_PORT_DISP_RDMA0>,
			 <&iommu0 M4U_PORT_MDP_RDMA0>,
			 <&iommu0 M4U_PORT_DISP_WDMA0>,
 			 <&iommu0 M4U_PORT_MDP_WROT0>,
			 <&iommu0 M4U_PORT_DISP_FAKE0>;
#endif
	};

	gps: gps@18C00000 {
		compatible = "mediatek,mt6990-gps";
		reg = <0 0x18000000 0 0x100000>,
			<0 0x18C00000 0 0x100000>,
			<0 0x18D00000 0 0x100000>,
			<0 0x10003304 0 0x4>,
			<0 0x1001C000 0 0x4>,
			<0 0x1001C030 0 0x4>;
		reg-names = "conn_infra_base", "conn_gps_base", "conn_dyn_base",
			"status_dummy_cr", "tia2_gps_on", "tia2_gps_rc_sel";
		interrupts = <GIC_SPI 380 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 381 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 382 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 383 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 384 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 385 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 386 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 387 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 388 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 389 IRQ_TYPE_EDGE_RISING>, /* gps mcu wdt irq */
			<GIC_SPI 390 IRQ_TYPE_LEVEL_HIGH>;
		memory-region = <&gps_mem>;
		pmic = <&pmic_efuse>;
		/*mtk-vcore-supply = <&dvfsrc_vcore>;*/
		emi-addr = <0>;
	};

	spi0: spi0@11010000 {
		compatible = "mediatek,mt6990-spi";
		mediatek,pad-select = <0>;
		reg = <0 0x11010000 0 0x100>;
		interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&topckgen_clk CLK_TOP_UNIVPLL_D6_D2>,
			<&topckgen_clk CLK_TOP_SPI_SEL>,
			<&pericfg_ao_clk CLK_PERAO_SPI0_BCLK>;
		clock-names = "parent-clk", "sel-clk", "spi-clk";
	};

	spi1: spi1@11011000 {
		compatible = "mediatek,mt6990-spi";
		mediatek,pad-select = <0>;
		reg = <0 0x11011000 0 0x100>;
		interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&topckgen_clk CLK_TOP_UNIVPLL_D6_D2>,
			<&topckgen_clk CLK_TOP_SPI_SEL>,
			<&pericfg_ao_clk CLK_PERAO_SPI1_BCLK>;
		clock-names = "parent-clk", "sel-clk", "spi-clk";
	};

	spi2: spi2@11012000 {
		compatible = "mediatek,mt6990-spi";
		mediatek,pad-select = <0>;
		reg = <0 0x11012000 0 0x100>;
		interrupts = <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&topckgen_clk CLK_TOP_UNIVPLL_D6_D2>,
			<&topckgen_clk CLK_TOP_SPI_SEL>,
			<&pericfg_ao_clk CLK_PERAO_SPI2_BCLK>;
		clock-names = "parent-clk", "sel-clk", "spi-clk";
	};

	spi3: spi3@11013000 {
		compatible = "mediatek,mt6990-spi";
		mediatek,pad-select = <0>;
		reg = <0 0x11013000 0 0x100>;
		interrupts = <GIC_SPI 255 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&topckgen_clk CLK_TOP_UNIVPLL_D6_D2>,
			<&topckgen_clk CLK_TOP_SPI_SEL>,
			<&pericfg_ao_clk CLK_PERAO_SPI3_BCLK>;
		clock-names = "parent-clk", "sel-clk", "spi-clk";
	};

	odm: odm {
		compatible = "simple-bus";
		/* reserved for overlay by odm */
	};

	pmic_clock_buffer_ctrl: pmic_clock_buffer_ctrl {
		compatible = "mediatek,pmic_clock_buffer";
		mediatek,clkbuf-quantity = <7>;
		mediatek,clkbuf-config = <2 1 1 2 0 0 2>;
		mediatek,clkbuf-output-impedance = <3 4 3 4 0 0 3>;
		mediatek,clkbuf-controls-for-desense = <0 4 0 3 0 0 0>;
		mediatek,bblpm-support = "enable";

		pwrap-dcxo-en = <0x24 4 0x28 1 0x28 0>;
		pwrap-dcxo-conn = <0x5c 0 0x5c 16 0x60 0 0x60 16>;
		pwrap-dcxo-nfc = <0x64 0 0x64 16 0x68 0 0x68 16>;

		spm-pwr-status = <0x16c 0 0x16c 1>;
		spm-io-en = <0x2c 7>;
		spm-power-on-val = <0x8 21 0x8 14>;
		spm-sck-con = <0xc 24>;
		pcm-reg7-rf = <0x10c 21>;

		pwrap = <&spmi_bus>;
		sleep = <&sleep>;
	};

	afe: mt6990-afe-pcm@11210000 {
		compatible = "mediatek,mt6990-sound";
		reg = <0 0x11210000 0 0x1000>;
		interrupts = <GIC_SPI 277 IRQ_TYPE_LEVEL_HIGH>;
		topckgen = <&topckgen_clk>;
		power-domains = <&scpsys MT6990_POWER_DOMAIN_AUDIO>;
		apmixedsys = <&apmixedsys_clk>;
		infracfg = <&infracfg_ao_clk>;
		clocks = <&afe_clk CLK_AFE_AFE>,
			 <&afe_clk CLK_AFE_DAC>,
			 <&afe_clk CLK_AFE_DAC_PREDIS>,
			 <&afe_clk CLK_AFE_ADC>,
			 <&afe_clk CLK_AFE_22M>,
			 <&afe_clk CLK_AFE_24M>,
