			 <&afe_clk CLK_AFE_TML>,
			 <&afe_clk CLK_AFE_I2S0_BCLK>,
			 <&afe_clk CLK_AFE_I2S1_BCLK>,
			 <&afe_clk CLK_AFE_I2S2_BCLK>,
			 <&afe_clk CLK_AFE_I2S4_BCLK>,
			 <&afe_clk CLK_AFE_I2S5_BCLK>,
			 <&afe_clk CLK_AFE_I2S6_BCLK>,
