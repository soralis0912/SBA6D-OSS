	};

	sgmiisys_0: sgmiisys@11304000 {
		compatible = "mediatek,colgin-sgmiisys_0", "syscon";
		reg = <0 0x11304000 0 0x1000>;
		#clock-cells = <1>;
		mediatek,physpeed = "2500";
	};

	sgmiisys_1: sgmiisys@11305000 {
		compatible = "mediatek,colgin-sgmiisys_1", "syscon";
		reg = <0 0x11305000 0 0x1000>;
		#clock-cells = <1>;
		mediatek,physpeed = "2500";
	};

	sgmiisys_phy_0: sgmiiphy@11E50000 {
		compatible = "mediatek,colgin-sgmiisys_phy_0", "syscon";
		reg = <0 0x11E50000 0 0x10000>;
		#clock-cells = <1>;
	};

	sgmiisys_phy_1: sgmiiphy@11E60000 {
		compatible = "mediatek,colgin-sgmiisys_phy_1", "syscon";
		reg = <0 0x11E60000 0 0x10000>;
		#clock-cells = <1>;
	};

	sgmiisys_uxphy_0: sgmiiphy@11306000 {
		compatible = "mediatek,colgin-sgmiisys_uxphy_0", "syscon";
		reg = <0 0x11306000 0 0x1000>;
		#clock-cells = <1>;
	};

	sgmiisys_uxphy_1: sgmiiphy@11307000 {
		compatible = "mediatek,colgin-sgmiisys_uxphy_1", "syscon";
		reg = <0 0x11307000 0 0x1000>;
		#clock-cells = <1>;
	};

	sgmiisys_pll: sgmiipll@10014000 {
		compatible = "mediatek,colgin-sgmiisys_pll", "syscon";
		reg = <0 0x10014000 0 0x1000>;
		#clock-cells = <1>;
	};

	ethsys: ethsys@15000000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "mediatek,leopard-ethsys", "syscon", "simple-mfd";
		reg = <0 0x15000000 0 0x1000>;
		#clock-cells = <1>;
		#reset-cells = <1>;

		ethsysrst: reset-controller {
			compatible = "ti,syscon-reset";
			#reset-cells = <1>;
			ti,reset-bits = <
				0x34 4 0x34 4 0x34 4 (ASSERT_SET | DEASSERT_CLEAR   | STATUS_SET) /* 4: wocpu_rst */
			>;
		};
	};

	hnat: hnat@15102200 {
		compatible = "mediatek,hnat", "syscon";
		reg = <0 0x15102200 0 0x1000>;
	};

	netsys@15100000 {
		compatible = "mediatek,mt6990-netsys";
		reg = <0 0x15100000 0 0x20000>;
		interrupts-extended = <&gic GIC_SPI 428 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 436 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 429 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 433 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 437 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 430 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 434 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 438 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "netsys-edma0", "netsys-edma1", "netsys-edma2",
				"netsys-edma0-g1", "netsys-edma1-g1", "netsys-edma2-g1",
				"netsys-edma0-r1", "netsys-edma1-r1", "netsys-edma2-r1";
		clocks = <&topckgen_clk CLK_TOP_NETSYS_SEL>,
			 <&topckgen_clk CLK_TOP_NETSYS_500M_SEL>,
			 <&topckgen_clk CLK_TOP_NETSYS_MED_MCU_SEL>,
			 <&topckgen_clk CLK_TOP_NETSYS_WED_MCU_SEL>,
			 <&topckgen_clk CLK_TOP_NETSYS_2X_SEL>;
		clock-names = "net_sel", "net_500_sel",
				"med_mcu_sel", "wed_mcu_sel",
				"net_2x_sel";
		power-domains = <&scpsys MT6990_POWER_DOMAIN_NET>;

		ranges;

		eth: ethernet@15100000 {
			compatible = "mediatek,mt6990-eth",
				     "syscon";
			reg = <0 0x15100000 0 0x30000>;

			interrupts-extended =
				<&gic GIC_SPI 407 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 408 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 400 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 401 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 402 IRQ_TYPE_LEVEL_HIGH>,
				<&gic GIC_SPI 403 IRQ_TYPE_LEVEL_HIGH>,
#if defined(CONFIG_QUECTEL_ETHERNET_PHY)
				<&pio 50 IRQ_TYPE_EDGE_FALLING>,
				<&pio 52 IRQ_TYPE_EDGE_FALLING>;
#else
				<&pio 50 IRQ_TYPE_LEVEL_LOW>,
				<&pio 52 IRQ_TYPE_LEVEL_HIGH>;
#endif
			clocks = <&topckgen_clk CLK_TOP_SGMII_0_SEL>,
					 <&topckgen_clk CLK_TOP_SGMII_SBUS_0_SEL>,
					 <&topckgen_clk CLK_TOP_SGMII_1_SEL>,
					 <&topckgen_clk CLK_TOP_SGMII_SBUS_1_SEL>,
					 <&topckgen_clk CLK_TOP_USXGMII_SBUS_0_SEL>,
				<&topckgen_clk CLK_TOP_USXGMII_SBUS_1_SEL>;
			clock-names = "sgmii_0_sel", "sgmii_sbus_0_sel", "sgmii_1_sel", "sgmii_sbus_1_sel",
						  "usxgmii_sbus_0_sel",	"usxgmii_sbus_1_sel";
			mediatek,ethsys = <&ethsys>;
			mediatek,sgmiisys = <&sgmiisys_0>,<&sgmiisys_1>;
			mediatek,sgmiisys_phy = <&sgmiisys_phy_0>,<&sgmiisys_phy_1>;
			mediatek,sgmiisys_uxphy = <&sgmiisys_uxphy_0>,<&sgmiisys_uxphy_1>;
			mediatek,sgmii_pll = <&sgmiisys_pll>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};
	};

	crypto: crypto@10320000 {
		/* compatible = "mediatek,eip97-crypto"; */
		/* compatible = "safexcel-ip-97-mob"; */
		/* compatible = "inside-secure,safexcel-eip97"; */
		compatible = "inside-secure,mt6990-safexcel-eip97", "mediatek,mt6990-eip97";
		reg = <0 0x10320000 0 0x40000>;
		interrupts = <GIC_SPI 217 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 218 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 219 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 220 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 221 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "ring0", "ring1", "ring2", "ring3";
		clocks = <&topckgen_clk CLK_TOP_EIP97_SEL>,
				<&topckgen_clk CLK_TOP_NET2PLL>,
				<&topckgen_clk CLK_TOP_MAINPLL_D5_D2>,
				<&infracfg_ao_clk CLK_IFRAO_EIP97>;
		clock-names = "clk-mux", "net2pll", "D5_D2", "infra";
		power-domains = <&scpsys MT6990_POWER_DOMAIN_EIP97>;
	};

