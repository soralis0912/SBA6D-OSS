	ssusb: usb@11201000 {
		compatible = "mediatek,mtu3";
		reg = <0 0x11201000 0 0x2e00>,
			<0 0x11203e00 0 0x0100>,
			<0 0x12001000 0 0x1000>,
			<0 0x11036000 0 0x1000>;
		reg-names = "mac", "ippc", "spm", "pericfg";
		vusb33-supply = <&mt6361_ldo27_vusb_reg>;
		interrupts = <GIC_SPI 274 IRQ_TYPE_LEVEL_HIGH>;
		phy-cells = <1>;
		phys = <&u2port0 PHY_TYPE_USB2>,
			 <&u3port0 PHY_TYPE_USB3>;
		clocks = <&pericfg_ao_clk CLK_PERAO_USB_SYS>,
			 <&pericfg_ao_clk CLK_PERAO_USB_XCHI>;
		clock-names = "sys_ck","ref_ck";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		dr_mode = "otg";
		maximum-speed = "super-speed-plus";
		mediatek,force-vbus;
		mediatek,clk-mgr;
		mediatek,usb3-drd;
		mediatek,gen1-txdeemph;
		usb-role-switch;
		/*plat_type = <1>; *//* 0: FPGA 1: ASIC */
		power-domains = <&scpsys MT6990_POWER_DOMAIN_SSUSB_TOP>;

		usb_host: xhci0@11200000 {
			compatible = "mediatek,mtk-xhci";
			reg = <0 0x11200000 0 0x1000>;
			reg-names = "mac";
			interrupts = <GIC_SPI 275 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk26m>;
			clock-names = "sys_ck";
		};
	};

	u3fpgaphy: usb-phy {
		compatible = "mediatek,fpga-u3phy";
		mediatek,ippc = <0x11203e00>;
		#address-cells = <2>;
		#size-cells = <2>;
		fpga_i2c_physical_base = <0x11ed0000>;
		status = "disabled";

		u3fpgaport0: usb-phy@0 {
			chip-id= <0xa60931a>;
			port = <0>;
			pclk_phase = <23>;
			#phy-cells = <1>;
		};
	};

	u3phy: usb-phy0@11ec0000 {
		compatible = "mediatek,xsphy";
		reg = <0 0x11ec3000 0 0x200>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		u2port0: usb2-phy0@11ec0000 {
			reg = <0 0x11ec0000 0 0x400>;
			clocks = <&clk26m>;
			clock-names = "ref";
			#phy-cells = <1>;
			/*usb2jtag = <&vlpcfg_bus_clk 2>;
			nvmem-cells = <&u2_phy_data>, <&u2_phy_data>;
			nvmem-cell-names = "intr_cal", "term_cal";
			nvmem-cell-masks = <0x3f 0xf00>;*/
			mediatek,efuse-u2-intr-cal = <0x23>;
			mediatek,efuse-u2-term-cal = <0x8>;
			mediatek,eye-vrt = <2>;
			mediatek,eye-vrt-host = <2>;
			mediatek,discth= <0x9>;
			mediatek,rev6= <0x1>;
			mediatek,sqth= <0x5>;
			nvmem-cells = <&u2_efuse_segment>;
			nvmem-cell-names = "u2_efuse_data";
		};

		u3port0: usb3-phy0@11ec3000 {
			reg = <0 0x11ec3400 0 0x500>;
			clocks = <&clk26m>;
			clock-names = "ref";
			#phy-cells = <1>;
			nvmem-cells = <&u3_efuse_segment>;
			nvmem-cell-names = "u3_efuse_data";
		};
	};

	apdma: dma-controller@11300000 {
		compatible = "mediatek, mt6873-uart-dma",
					 "mediatek,mt6577-uart-dma";
		reg = <0 0x11300400 0 0x80>,
			  <0 0x11300480 0 0x80>,
			  <0 0x11300500 0 0x80>,
			  <0 0x11300580 0 0x80>,
			  <0 0x11300600 0 0x80>,
			  <0 0x11300680 0 0x80>;
		interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH>,
			  <GIC_SPI 245 IRQ_TYPE_LEVEL_HIGH>,
			  <GIC_SPI 246 IRQ_TYPE_LEVEL_HIGH>,
			  <GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH>,
			  <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>,
			  <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH>;
		dma-requests = <6>;
		dma-bits = <34>;
		clocks = <&clk26m>;
		#dma-cells = <1>;
	};

	auxadc: auxadc@11001000 {
		compatible = "mediatek,mt6765-auxadc";
		reg = <0 0x11001000 0 0x1000>;
		interrupts = <GIC_SPI 64 IRQ_TYPE_EDGE_RISING>;
//  Need to update to MT6990 clock, modified by Pei-hsuan Cheng
/*		clocks = <&infracfg_ao_clk CLK_IFRAO_AUXADC>;*/
		clock-names = "main";
		#io-channel-cells = <1>;
		/* Auxadc efuse calibration */
		/* 1. Auxadc cali on/off bit shift */
		mediatek,cali-en-bit = <20>;
		/* 2. Auxadc cali ge bits shift */
		mediatek,cali-ge-bit = <10>;
		/* 3. Auxadc cali oe bits shift */
		mediatek,cali-oe-bit = <0>;
		/* 4. Auxadc cali efuse reg offset */
		mediatek,cali-efuse-reg-offset = <0xf8>;
		nvmem = <&efuse>;
		nvmem-names = "mtk_efuse";
		#interconnect-cells = <1>;
	};

	uart0: serial@11002000 {
		compatible = "mediatek,mt6873-uart",
					 "mediatek,mt6577-uart";
		reg = <0 0x11002000 0 0x1000>;
		interrupts = <GIC_SPI 232 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk26m>, <&pericfg_ao_clk CLK_PERAO_UART0>;
		clock-names = "baud", "bus";
		dmas = <&apdma 0
				&apdma 1>;
		dma-names = "tx", "rx";
	};

	uart1: serial@11003000 {
		compatible = "mediatek,mt6873-uart",
					 "mediatek,mt6577-uart";
		reg = <0 0x11003000 0 0x1000>,
		      <0 0x11036b90 0 0x20>;
		interrupts = <GIC_SPI 233 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk26m>, <&pericfg_ao_clk CLK_PERAO_UART1>;
		clock-names = "baud", "bus";
		dmas = <&apdma 2
				&apdma 3>;
		dma-names = "tx", "rx";
	};

	uart2: serial@11004000 {
		compatible = "mediatek,mt6873-uart",
					 "mediatek,mt6577-uart";
		reg = <0 0x11004000 0 0x1000>;
		interrupts = <GIC_SPI 234 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk26m>, <&pericfg_ao_clk CLK_PERAO_UART2>;
		clock-names = "baud", "bus";
		dmas = <&apdma 4
				&apdma 5>;
		dma-names = "tx", "rx";
	};

	nandc: nfi@11006000 {
		compatible = "mediatek,mt6880-nfc";
		reg = <0 0x11006000 0 0x1000>,
		      <0 0x11007000 0 0x1000>;
		interrupts = <GIC_SPI 258 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 259 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
		clocks =<&topckgen_clk CLK_TOP_TCK_26M_MX9>,
				<&topckgen_clk CLK_TOP_UNIVPLL_D5_D4>,
				<&topckgen_clk CLK_TOP_MAINPLL_D7_D4>,
				<&topckgen_clk CLK_TOP_MAINPLL_D6_D4>,
				<&topckgen_clk CLK_TOP_UNIVPLL_D6_D4>,
				<&topckgen_clk CLK_TOP_MAINPLL_D4_D4>,
				<&topckgen_clk CLK_TOP_UNIVPLL_D4_D4>,
				<&topckgen_clk CLK_TOP_MAINPLL_D6_D2>,
				<&topckgen_clk CLK_TOP_NFI1X_SEL>,
				<&pericfg_ao_clk CLK_PERAO_NFI_HCLK>,
				<&pericfg_ao_clk CLK_PERAO_NFI_BCLK>,
				/* The following clocks are snfi clocks */
				<&topckgen_clk CLK_TOP_TCK_26M_MX9>,
				<&topckgen_clk CLK_TOP_UNIVPLL_D6_D8>,
				<&topckgen_clk CLK_TOP_UNIVPLL_D5_D8>,
				<&topckgen_clk CLK_TOP_MAINPLL_D4_D8>,
				<&topckgen_clk CLK_TOP_UNIVPLL_D4_D8>,
				<&topckgen_clk CLK_TOP_MAINPLL_D6_D4>,
				<&topckgen_clk CLK_TOP_UNIVPLL_D6_D4>,
				<&topckgen_clk CLK_TOP_UNIVPLL_D5_D4>,
				<&topckgen_clk CLK_TOP_SPINFI_BCLK_SEL>,
				<&pericfg_ao_clk CLK_PERAO_NFI_CFCLK>;
		clock-names = "nfi_parent_26m",
				"nfi_parent124.8m",
				"nfi_parent78m",
				"nfi_parent91m",
				"nfi_parent104m",
				"nfi_parent136.5m",
				"nfi_parent156m",
				"nfi_parent182m",
				"nfi_clk_sel",
				"dma_cg",
				"nfi_cg",
				/* The following clock names are snfi clock names */
				"snfi_parent_26m",
				"snfi_parent52m",
				"snfi_parent62.4m",
				"snfi_parent68.25",
				"snfi_parent78m",
				"snfi_parent91m",
				"snfi_parent104m",
				"snfi_parent124.8m",
				"snfi_clk_sel",
				"snfi_cg";
		nand-trap {
			trap-base = <0x100046F0>;
			trap-mask = <0x001C0000>;
			trap-list = <0x00000000 0x000C0000>;
			trap-name-list = "pnand", "snand";
		};
	};

    mmc0: mmc@11230000 {
        compatible = "mediatek,mt6990-mmc";
        reg = <0 0x11230000 0 0x1000>,
            <0 0x11f00000 0 0x1000>;
        interrupts = <GIC_SPI 260 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&pericfg_ao_clk CLK_PERAO_MSDC50_SCAN>,
                <&pericfg_ao_clk CLK_PERAO_MSDC50_HCLK>,
                <&pericfg_ao_clk CLK_PERAO_MSDC0_AXI_MASTER>,
                <&pericfg_ao_clk CLK_PERAO_MSDC0_AHB_SLAVE>;
        clock-names = "source", "hclk", "axi_clk", "ahb_clk";
        power-domains = <&scpsys MT6990_POWER_DOMAIN_MSDC>;

        status = "disabled";
    };

    mmc1: mmc@11240000 {
        compatible = "mediatek,mt6990-mmc";
        reg = <0 0x11240000 0 0x1000>,
            <0 0x11d60000 0 0x1000>;
        interrupts = <GIC_SPI 261 IRQ_TYPE_LEVEL_HIGH>;

        clocks = <&pericfg_ao_clk CLK_PERAO_MSDC1_SRC>,
                <&pericfg_ao_clk CLK_PERAO_MSDC1_HCLK>;
        clock-names = "source", "hclk";
        power-domains = <&scpsys MT6990_POWER_DOMAIN_MSDC>;

        status = "disabled";
    };

	pd-sgmii_0_phy {
		compatible = "mediatek,sgmii-bring-up";
		mediatek,pwr_type = <0>;
