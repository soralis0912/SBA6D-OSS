	sspm@12300000 {
		compatible = "mediatek,sspm";
		reg = <0 0x12300000 0 0x28000>,
			<0 0x12340000 0 0x10000>,
			<0 0x12350000 0 0x100>,
			<0 0x12351000 0 0x4>,
			<0 0x12351004 0 0x4>,
			<0 0x12360000 0 0x100>,
			<0 0x12361000 0 0x4>,
			<0 0x12361004 0 0x4>,
			<0 0x12370000 0 0x100>,
			<0 0x12371000 0 0x4>,
			<0 0x12371004 0 0x4>,
			<0 0x12380000 0 0x100>,
			<0 0x12381000 0 0x4>,
			<0 0x12381004 0 0x4>,
			<0 0x12390000 0 0x100>,
			<0 0x12391000 0 0x4>,
			<0 0x12391004 0 0x4>;

		reg-names = "sspm_base",
			"cfgreg",
			"mbox0_base",
			"mbox0_set",
			"mbox0_clr",
			"mbox1_base",
			"mbox1_set",
			"mbox1_clr",
			"mbox2_base",
			"mbox2_set",
			"mbox2_clr",
			"mbox3_base",
			"mbox3_set",
			"mbox3_clr",
			"mbox4_base",
			"mbox4_set",
			"mbox4_clr";

		interrupts = <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 147 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 148 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>;

		interrupt-names = "ipc",
			"mbox0",
			"mbox1",
			"mbox2",
			"mbox3",
			"mbox4";

		sspm_res_ram_start = <0x0>;
#if defined(CONFIG_MTK_GMO_RAM_OPTIMIZE) || defined(CONFIG_MTK_MET_MEM_ALLOC)
		sspm_res_ram_size = <0x210000>; /* 2M + 64K */
#else
		sspm_res_ram_size = <0x610000>; /* 6M + 64K */
#endif
	};

