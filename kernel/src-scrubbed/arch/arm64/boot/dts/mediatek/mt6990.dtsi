	spmi_bus: spmi@12804000 {
		compatible = "mediatek,mt6990-spmi";
		reg = <0 0x12804000 0 0x0008ff>,
		      <0 0x12806000 0 0x000120>;
		reg-names = "pmif", "spmimst";
		interrupts-extended = <&gic GIC_SPI 168 IRQ_TYPE_LEVEL_HIGH>,
				      <&pio 220 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "pmif_irq", "rcs_irq";
		interrupt-controller;
		#interrupt-cells = <1>;
		irq_event_en = <0x80000000 0x0 0x0 0x0 0x0>;
		clocks = <&vlp_cksys_clk CLK_VLP_CK_PWRAP_ULPOSC_SEL>,
			 <&vlp_cksys_clk CLK_VLP_CK_SPMI_M_MST_SEL>;
		clock-names = "vlp_pmif_clk_mux",
			      "vlp_spmimst_m_clk_mux";
		swinf_ch_start = <10>;
		ap_swinf_no = <2>;
		grpid = <0xB>;
		#address-cells = <2>;
		#size-cells = <0>;
	};

