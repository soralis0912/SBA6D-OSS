		compatible = "mediatek,mt6980-emimpu",
			     "mediatek,common-emimpu";
		reg = <0 0x1021a000 0 0x1000>;
		mediatek,emi-reg = <&emicen>;
		interrupts = <GIC_SPI 338 IRQ_TYPE_LEVEL_HIGH>;
		region_cnt = <32>;
		domain_cnt = <16>;
		addr_align = <16>;
		ap_region = <31>;
		ap_apc = <5 5 0 5 0 0 6 5>,
			 <0 0 5 5 5 5 5 5>;
		dump = <0x1f0 0x1f8 0x1fc>;
		clear = <0x160 0xffffffff 16>,
			<0x200 0x00000003 16>,
			<0x1f0 0x80000000 1>;
		clear_md = <0x1fc 0x80000000 1>;
		ctrl_intf = <1>;
		slverr = <0>;
	};

	cldma_sys_ap {
		compatible = "mediatek,cldma_sys_ap";
		reg = <0 0x1004A000 0 0x1000>, /*CLDMA0_AO_INDMA_AO_MD*/
			<0 0x1021E000 0 0x1000>; /*CLDMA0_AO_INDMA_PD_MD*/
		interrupts = <GIC_SPI 285 IRQ_TYPE_LEVEL_HIGH>; /*cldma0_md_int_ap*/
//  Need to update to MT6990 clock, modified by Pei-hsuan Cheng
/*		clocks = <&infracfg_ao_clk CLK_IFRAO_RG_133M_CLDMA_TOP>;*/
		clock-names = "infra-cldma0-rh";
		mediatek,hif_ids = <1>; /* (1 << HIF_ID_CLDMA) */
	};

	mrdump_ext_rst: mrdump_ext_rst {
		compatible = "mediatek, mrdump_ext_rst-eint";
		force_mode = "EINT";
		mode = "IRQ";
		status = "okay";
	};

	cpu_mcucfg: mcusys_ao_cfg@0c530000 {
		reg = <0 0x0c530000 0 0x10000>; /* 64KB */
	};

	bus_tracer@0d040000 {
		compatible = "mediatek,bus_tracer-v1";
		reg = <0 0x0d040000 0 0x100>, /* btm_top base */
			  <0 0x0d01a000 0 0x1000>, /* dbgao base */
			  <0 0x0d041000 0 0x3000>, /* funnel/rep/etr base */
			  <0 0x0d044000 0 0x1000>, /* bus tracer etf base */
			  <0 0x0d040800 0 0x100>, /* MCU_AP bus tracer base */
			  <0 0x0d040900 0 0x100>, /* infra bus tracer base */
			  <0 0x0d040a00 0 0x100>; /* peri bus tracer base */

		mediatek,err_flag = <0xfbf8ffff>;

		/*
		 * index 0 for ap bus tracer
		 * index 1 for infra bus tracer
		 * index 2 for peri bus tracer
		 */
		mediatek,num_tracer = <3>;
		mediatek,enabled_tracer = <1 1 1>;
		mediatek,at_id = <0x10 0x30 0x70>;

		/* filters: disabled by default */
		/*
		 * mediatek,watchpoint_filter = <0x0 0x10010000 0xfffff000>;
		 * mediatek,bypass_filter = <0x14000000 0xffff0000>;
		 * mediatek,id_filter = <0x10 0x40>;
		 * mediatek,rw_filter = <0x0 0x1>;
		 */
	};

	cpu_pll: mcusys_pll1u_top@01000c000 {
		reg = <0 0x10010000 0 0x1000>; /* 4KB */
	};

	cpuhvfs: cpuhvfs {
		compatible = "mediatek,cpufreq-hybrid";
		reg = <0 0x0011bc90 0 0xc00>,
			<0 0x0011bc00 0 0x1400>,
			<0 0x00121400 0 0x1800>;
		reg-names = "USRAM", "CSRAM", "ESRAM";
		cslog-range = <0x0578>, <0x0ed8>;
		tbl-off = <4>, <76>;
		/* pll mcucfg */
		mcucfg-ver = <0>;
		apmixedsys = <&cpu_pll>;
		clk-div-base = <&cpu_mcucfg>;
		pll-con = <0x2f4>, <0x330>;
		clk-div = <0xa2a0>, <0xa2e0>;
		/* regulator */
		proc1-supply = <&mt6319_6_vbuck3>; /* L */
		proc2-supply = <&mt6319_6_vbuck3>; /* DSU */
	};

	ccifdriver:ccifdriver@10209000 {
		compatible = "mediatek,ccci_ccif";
		reg = <0 0x10209000 0 0x1000>, /*AP_CCIF_BASE*/
			<0 0x1020a000 0 0x1000>; /*MD_CCIF_BASE*/
		mediatek,sram_size = <512>;
		/* CCIF0 184/216; CCIF1 185/217 */
		interrupts = <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 185 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&infracfg_ao_clk CLK_IFRAO_CCIF0>,
			<&infracfg_ao_clk CLK_IFRAO_CCIF1>;
		clock-names = "infra-ccif0",
			"infra-ccif1";
	};

	mddriver:mddriver {
		compatible = "mediatek,mddriver";
		/* bit0~3: CLDMA|CCIF|DPMAIF */
		mediatek,mdhif_type = <2>;
		mediatek,md_id = <0>;
		mediatek,ap_plat_info = <6990>;
		mediatek,md_generation = <6298>;
		/* DTSI apon_md is for colgin */
		/* mediatek,offset_apon_md1 = <0x2844>; */
		/* 0x44: epon offset; */
		/* 0x06: once a value[1] exist, means in l2sram */
		/* value[1] not exist means in mddbgsys. the value(6) has no meaningful */
		mediatek,offset_epon_md1 = <0x44 0x06>;
		mediatek,cldma_capability = <2>;
		/* bit0:srcclkena|bit1:srclken_o1_on|bit2:revert_sequencer| */
		/* bit3:pll_setting|bit4:skip_topclk */
		mediatek,power_flow_config = <0x04>;
		/* srclken_o1 set value |= 1<<21 */
		mediatek,srclken_o1 = <0>;
		/* WDT pattern in l2sram */
		reg = <0 0x0d124000 0 0x2000>; /* l2sram base address */
		/* MDWDT 333/365 */
		interrupts = <GIC_SPI 333 IRQ_TYPE_LEVEL_HIGH>;
		/* md_vmodem-supply = <&mt6315_3_vbuck1>; move mt6873.dts */
		/* md_vsram-supply = <&mt6315_3_vbuck4>; move mt6873.dts */
		/* md_vnr-supply = <&mt6315_3_vbuck3>; move mt6873.dts */
		/* md_vdigrf-supply = <&mt6359p_vpu_reg>; move mt6873.dts */
		power-domains = <&scpsys MT6990_POWER_DOMAIN_MD>;
		ccci-infracfg = <&infracfg_ao_clk>;
	};

/*	md_auxadc:md_auxadc {
		compatible = "mediatek,md_auxadc";
		io-channels = <&auxadc 2>;
		io-channel-names = "md-channel",
			"md-battery";
	};

	md_ccci_rtc:md_ccci_rtc {
		compatible = "mediatek,md_ccci_rtc";
		nvmem-cells = <&ext_32k>;
		nvmem-cell-names = "external-32k";
	}; */

	gce_mbox: gce_mbox@10228000 {
		compatible = "mediatek,mailbox-gce";
		reg = <0 0x10228000 0 0x4000>;
		interrupts = <GIC_SPI 202 IRQ_TYPE_LEVEL_HIGH>;

		#mbox-cells = <3>;
		#gce-event-cells = <1>;
		#gce-subsys-cells = <2>;
		default_tokens = /bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_0>,
			/bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_1>,
			/bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_2>,
			/bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_3>,
			/bits/ 16 <CMDQ_SYNC_TOKEN_GPR_SET_4>,
			/bits/ 16 <CMDQ_SYNC_RESOURCE_WROT0>,
			/bits/ 16 <CMDQ_SYNC_RESOURCE_WROT1>;
		clocks = <&infracfg_ao_clk CLK_IFRAO_GCE_AXI>,
			 <&infracfg_ao_clk CLK_IFRAO_GCE>;
		clock-names = "gce", "gce-timer";
	};

	infra_dpmaif@1022c000 {
		compatible = "mediatek,infra_dpmaif";
		reg = <0 0x1022c000 0 0x10>;
	};

	dramc: dramc@10230000 {
		compatible = "mediatek,mt6990-dramc",
			"mediatek,common-dramc";
		reg = <0 0x10230000 0 0x2000>, /* DRAMC AO CHA */
			<0 0x10240000 0 0x2000>, /* DRAMC AO CHB */
			<0 0x10234000 0 0x1000>, /* DRAMC NAO CHA */
			<0 0x10244000 0 0x1000>, /* DRAMC NAO CHB */
			<0 0x10238000 0 0x2000>, /* DDRPHY AO CHA */
			<0 0x10248000 0 0x2000>, /* DDRPHY AO CHB */
			<0 0x10236000 0 0x2000>, /* DDRPHY NAO CHA */
			<0 0x10246000 0 0x2000>, /* DDRPHY NAO CHB */
			<0 0x10006000 0 0x1000>; /* SLEEP BASE */
		mr4_version = <1>;
		mr4_rg = <0x0090 0x0000ffff 0>;
		fmeter_version = <2>;
		crystal_freq = <26>;
		pll_id = <0x0CB4 0x00000100 8>;
		shu_lv = <0x0CB4 0x00030000 16>;
		shu_of = <0x700>;
		sdmpcw = <0x0908 0x0007FFF8 3>,
			<0x0928 0x0007FFF8 3>;
		prediv = <0x090C 0x0000c000 14>,
			<0x092C 0x0000c000 14>;
		posdiv = <0x090C 0x0003800 11>,
			<0x092C 0x0003800 11>;
		ckdiv4 = <0x0874 0x00000004 2>,
			<0x0874 0x00000004 2>;
		pll_md = <0x0744 0x00000100 8>,
			<0x0744 0x00000100 8>;
		cldiv2 = <0x08b4 0x00000002 1>,
			<0x08b4 0x00000002 1>;
		fbksel = <0x0910 0x00000020 5>,
			<0x0910 0x00000020 5>;
		dqopen = <0x0D94 0x2000000 25>,
			<0x0D94 0x2000000 25>;
		ckdiv4_b0 = <0x13EC 0x00000004 2>,
			<0x13EC 0x00000004 2>;
		ckdiv4_ca = <0x136C 0x00000004 2>,
			<0x136C 0x00000004 2>;
	};

	emichn: emichn@10235000 {
		compatible = "mediatek,mt6980-emichn",
			     "mediatek,common-emichn";
		reg = <0 0x10235000 0 0x1000>,
		      <0 0x10245000 0 0x1000>;
	};

	emi-fake-eng@10219000 {
		compatible = "mediatek,emi-fake-engine";
		reg = <0 0x10219000 0 0x100>,
		      <0 0x10219800 0 0x100>;
	};

	emiisu {
		compatible = "mediatek,mt6980-emiisu",
			     "mediatek,common-emiisu";
		ctrl_intf = <1>;
	};

dpmaif:dpmaif@0x10011000 {
		compatible = "mediatek,dpmaif";
		reg = <0 0x10011000 0 0x1000>, /*AO_UL*/
			<0 0x1022D000 0 0x1000>, /*PD_UL*/
			<0 0x1022C000 0 0x1000>, /*PD_MD_MISC*/
			<0 0x1022E000 0 0x1000>, /*SRAM*/
			<0 0x15B14000 0 0x1000>, /*MED_BMP_CFG*/
			<0 0x15B38000 0 0x1000>, /*MED_SSR1_CFG*/
			<0 0x15B13000 0 0x1000>; /*MED_INT_MNG*/
		interrupts = <GIC_SPI 209 IRQ_TYPE_LEVEL_HIGH>, /*209+32=241*/
                <GIC_SPI 456 IRQ_TYPE_LEVEL_HIGH>;
		mediatek,dpmaif_capability = <6>;
		clocks = <&infracfg_ao_clk CLK_IFRAO_DPMAIF>,
			<&infracfg_ao_clk CLK_IFRAO_RG_MMW_DPMAIF26M_CK>;
		clock-names = "infra-dpmaif-clk",
			"infra-dpmaif-rg-mmw-clk";
	};


	medmcu: medmcu@15f00000 {
		compatible = "mediatek,medmcu";
		status = "okay";
		reg = <0 0x15d00000 0 0x20000>,  /* tcm */
			<0 0x15f24000 0 0x1000>,     /* cfg */
			<0 0x15f21000 0 0x1000>,     /* clk*/
			<0 0x15f30000 0 0x1000>,     /* cfg core0 */
			<0 0x15f40000 0 0x1000>,     /* cfg core1 */
			<0 0x15f52000 0 0x1000>,     /* bus tracker */
			<0 0x15f60000 0 0x40000>,    /* llc */
			<0 0x15fa5000 0 0x4>,        /* cfg_sec */
			<0 0x15ffb000 0 0x100>,      /* mbox0 base */
			<0 0x15ffb100 0 0x4>,        /* mbox0 set */
			<0 0x15ffb10c 0 0x4>,        /* mbox0 clr */
			<0 0x15fa5020 0 0x4>,        /* mbox0 init */
			<0 0x15ffc000 0 0x100>,      /* mbox1 base */
			<0 0x15ffc100 0 0x4>,        /* mbox1 set */
			<0 0x15ffc10c 0 0x4>,        /* mbox1 clr */
			<0 0x15fa5024 0 0x4>,        /* mbox1 init */
			<0 0x15ffd000 0 0x100>,      /* mbox2 base */
			<0 0x15ffd100 0 0x4>,        /* mbox2 set */
			<0 0x15ffd10c 0 0x4>,        /* mbox2 clr */
			<0 0x15fa5028 0 0x4>,        /* mbox2 init */
			<0 0x15ffe000 0 0x100>,      /* mbox3 base */
			<0 0x15ffe100 0 0x4>,        /* mbox3 set */
			<0 0x15ffe10c 0 0x4>,        /* mbox3 clr */
			<0 0x15fa502c 0 0x4>,        /* mbox3 init */
			<0 0x15fff000 0 0x100>,      /* mbox4 base */
			<0 0x15fff100 0 0x4>,        /* mbox4 set */
			<0 0x15fff10c 0 0x4>,        /* mbox4 clr */
			<0 0x15fa5030 0 0x4>,        /* mbox4 init */
			<0 0x15b80000 0 0x100>;      /* medsys infra top cfg */

		reg-names = "scp_sram_base",
			"scp_cfgreg",
			"scp_clkreg",
			"scp_cfgreg_core0",
			"scp_cfgreg_core1",
			"scp_bus_tracker",
			"scp_l1creg",
			"scp_cfgreg_sec",
			"mbox0_base",
			"mbox0_set",
			"mbox0_clr",
			"mbox0_init",
			"mbox1_base",
			"mbox1_set",
			"mbox1_clr",
			"mbox1_init",
			"mbox2_base",
			"mbox2_set",
			"mbox2_clr",
			"mbox2_init",
			"mbox3_base",
			"mbox3_set",
			"mbox3_clr",
			"mbox3_init",
			"mbox4_base",
			"mbox4_set",
			"mbox4_clr",
			"mbox4_init";

		interrupts = <GIC_SPI 463 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 464 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 465 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 466 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 467 IRQ_TYPE_LEVEL_HIGH>;


		interrupt-names = "mbox0",
			"mbox1",
			"mbox2",
			"mbox3",
			"mbox4";

		core_0 = "enable";
		scp_sramSize = <0x00020000>;
		mbox_count = <5>;
		/* id, mbox, send_size */
		send_table =
		<0 0 7>,     /* IPI_OUT_AUDIO_VOW_1 */
		<3 1 2>,     /* IPI_OUT_APCCCI_0 */
		<4 1 1>,     /* IPI_OUT_DVFS_SET_FREQ_0 */
		<5 1 1>,     /* IPI_OUT_C_SLEEP_0 */
		<6 1 1>,     /* IPI_OUT_TEST_0 */
		<11 2 18>,   /* IPI_OUT_MED_TABLE_ADDR */
		<13 2 1>,    /* IPI_OUT_MED_STOP */
		<15 3 1>,    /* IPI_OUT_QUERY_MED_SUSPEND */
		<16 3 1>,    /* IPI_OUT_DVFS_SET_FREQ_1 */
		<17 3 1>,    /* IPI_OUT_C_SLEEP_1 */
		<18 3 1>,    /* IPI_OUT_TEST_1 */
		<19 3 1>,    /* IPI_OUT_MED_UNMASK_IRQ */
		<20 3 1>,    /* IPI_OUT_LOGGER_ENABLE_1 */
		<21 3 1>,    /* IPI_OUT_LOGGER_WAKEUP_1 */
		<22 3 2>,    /* IPI_OUT_LOGGER_INIT_1 */
		<23 3 2>,    /* IPI_OUT_SCPCTL_1 */
		<24 3 2>,    /* IPI_OUT_SCP_LOG_FILTER_1 */
		<31 4 34>;   /* IPI_OUT_SCP_MPOOL_1 */
		/* id, mbox, recv_size, recv_opt */
		recv_table =
		<1 0 2 0>,   /* IPI_IN_AUDIO_VOW_ACK_1 */
		<2 0 20 0>,  /* IPI_IN_AUDIO_VOW_1 */
		<7 1 2 0>,   /* IPI_IN_APCCCI_0 */
		<8 1 10 0>,  /* IPI_IN_SCP_ERROR_INFO_0 */
		<9 1 1 0>,   /* IPI_IN_SCP_READY_0 */
		<10 1 2 0>,  /* IPI_IN_SCP_RAM_DUMP_0 */
		<5 1 1 1>,   /* IPI_OUT_C_SLEEP_0 */
		<12 2 2 0>,  /* IPI_IN_MED_CCCI */
		<14 2 2 0>,  /* IPI_IN_MED_STOP_ACK */
		<25 3 2 0>,  /* IPI_IN_MED_SUSPEND_RESPONSE */
		<26 3 10 0>, /* IPI_IN_SCP_ERROR_INFO_1 */
		<27 3 1 0>,  /* IPI_IN_LOGGER_WAKEUP_1 */
		<28 3 5 0>,  /* IPI_IN_LOGGER_INIT_1 */
		<29 3 1 0>,  /* IPI_IN_SCP_READY_1 */
		<30 3 2 0>,  /* IPI_IN_SCP_RAM_DUMP_1 */
		<17 3 1 1>,  /* IPI_OUT_C_SLEEP_1 */
		<32 4 30 0>; /* IPI_IN_SCP_MPOOL_1 */

		power-domains = <&scpsys MT6990_POWER_DOMAIN_MED>;
		clocks = <&topckgen_clk CLK_TOP_NETSYS_MED_MCU_SEL>;
		clock-names = "medmcu_sel";
	};

