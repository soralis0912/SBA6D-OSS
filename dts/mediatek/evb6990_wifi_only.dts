		};
	};
	aud_gpio_pcm1_on: aud_gpio_pcm1_on {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO28__FUNC_PCM1_CLK>;
			bias-disable;
		};
		pins_cmd1_dat {
